<Project Sdk="Microsoft.NET.Sdk">
  <!-- Reverting an update: the installer record, the release lookup by version, download, verification and launch (LightWeaver.Core/Updates). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LightWeaver.Core/LightWeaver.Core.csproj" />
  </ItemGroup>
</Project>
