<Project Sdk="Microsoft.NET.Sdk">
  <!-- The login form's address rules and server probing (LightWeaver.Core/Login), and the sign-out
       order against a local stand-in server, without a UI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LightWeaver.Core/LightWeaver.Core.csproj" />
  </ItemGroup>
</Project>
