<Project Sdk="Microsoft.NET.Sdk">
  <!-- SyncPlay: the drift correction around a member's own buffering (LightWeaver.Core/Jellyfin/SyncPlayScheduler) and normalization in group playback (MpvPlayer.NormalizesAudio). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LightWeaver.Core/LightWeaver.Core.csproj" />
  </ItemGroup>
</Project>
