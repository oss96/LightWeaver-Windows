<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/LightWeaver.Localization/LightWeaver.Localization.csproj" />
    <!-- Compile the production runtime, without constructing a WPF window. -->
    <Compile Include="../../src/LightWeaver/Localization/L.cs" Link="L.cs" />
    <EmbeddedResource Include="fixtures/catalog.json" LogicalName="LightWeaver.Localization.catalog.json" />
    <EmbeddedResource Include="fixtures/locales/*.json" LogicalName="LightWeaver.Localization.locales.%(Filename).json" />
  </ItemGroup>
</Project>
