<?xml version="1.0" encoding="utf-8"?>
<!-- Token field (design 05, Genre): chosen values as removable tokens, then an inline input with
     suggestions. Used for Genre and Person. -->
<UserControl
    x:Class="LightWeaver.WinUI.Controls.TokenBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LightWeaver.WinUI.Controls">

    <Grid MinHeight="{StaticResource LwFieldHeight}">
        <Border x:Name="Chrome" CornerRadius="{StaticResource LwControlRadius}" Background="{StaticResource LwFieldBrush}"
                BorderBrush="{StaticResource LwFieldBorderBrush}" BorderThickness="1" />
        <Border x:Name="Bottom" Height="1" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="0,0,4,4"
                Background="{StaticResource LwFieldBottomBrush}" />
        <c:WrapPanel x:Name="Tokens" Margin="4" HorizontalSpacing="4" VerticalSpacing="4">
            <Grid x:Name="InputHost" MinWidth="90" Height="22">
                <TextBlock x:Name="Placeholder" FontSize="12.5" Foreground="{StaticResource LwText3Brush}" Margin="6,0"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <TextBox x:Name="Input" Style="{StaticResource LwBareTextBox}" FontSize="12.5" Padding="6,0" VerticalAlignment="Stretch"
                         TextChanged="OnInputChanged" KeyDown="OnInputKeyDown" GotFocus="OnFocusChanged" LostFocus="OnFocusChanged" />
            </Grid>
        </c:WrapPanel>
        <FlyoutBase.AttachedFlyout>
            <Flyout x:Name="SuggestFlyout" Placement="BottomEdgeAlignedLeft" AreOpenCloseAnimationsEnabled="False" ShowMode="Transient">
                <Flyout.FlyoutPresenterStyle>
                    <Style TargetType="FlyoutPresenter">
                        <Setter Property="Padding" Value="4" />
                        <Setter Property="MinWidth" Value="200" />
                        <Setter Property="Background" Value="{StaticResource LwPopupBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource LwPopupBorderBrush}" />
                        <Setter Property="CornerRadius" Value="8" />
                    </Style>
                </Flyout.FlyoutPresenterStyle>
                <ListView x:Name="Suggestions" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSuggestionClick"
                          MaxHeight="260" KeyDown="OnSuggestionsKeyDown">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="c:TokenSuggestion">
                            <TextBlock Text="{x:Bind Label}" FontSize="13" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Flyout>
        </FlyoutBase.AttachedFlyout>
    </Grid>
</UserControl>
