<?xml version="1.0" encoding="utf-8"?>
<!-- Item card, Windows variant of the design's Card.dc.html: artwork (2:3 poster, 16:9 wide or
     square) with 8 px corners, or a circle for a person, title and subtitle below. Hover lightens the artwork,
     draws a 1 px inner ring and shows the round play button in the centre and the action pill
     (mark watched, more); a watched title shows a check badge, a count badge replaces it.
     Resumable items show a progress bar. The current item of a list (the episode on show) has a
     2 px accent ring; a downloaded title has a download badge (available offline). -->
<UserControl
    x:Class="LightWeaver.WinUI.Controls.MediaCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LightWeaver.WinUI.Controls"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    IsTabStop="True" UseSystemFocusVisuals="True"
    PointerEntered="OnPointerEntered" PointerExited="OnPointerExited" PointerCanceled="OnPointerExited">

    <StackPanel x:Name="Body" Spacing="7">
        <c:AspectGrid x:Name="Art" CornerRadius="{StaticResource LwCardRadius}" Background="{StaticResource LwPlaceholderBrush}">
            <Image x:Name="Picture" Stretch="UniformToFill" />
            <Border x:Name="UpcomingBadge" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0"
                    MinHeight="22" Padding="8,1" CornerRadius="10" Background="#8C000000" Visibility="Collapsed" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <FontIcon Style="{StaticResource LwIcon}" FontSize="13" Foreground="White" Glyph="{x:Bind t:Icons.Clock}" />
                    <TextBlock x:Name="UpcomingText" FontSize="11.5" FontWeight="SemiBold" Foreground="White" />
                </StackPanel>
            </Border>
            <Border x:Name="HoverWash" Background="#0DFFFFFF" Visibility="Collapsed" />
            <Border x:Name="HoverRing" BorderBrush="#29FFFFFF" BorderThickness="1" CornerRadius="{StaticResource LwCardRadius}" Visibility="Collapsed" />
            <Border x:Name="CurrentRing" BorderBrush="{StaticResource LwAccentFgBrush}" BorderThickness="2" CornerRadius="{StaticResource LwCardRadius}" Visibility="Collapsed" />
            <Border x:Name="WatchedBadge" Width="20" Height="20" CornerRadius="10" Background="#8C000000" Margin="0,6,6,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                <FontIcon Style="{StaticResource LwIcon}" FontSize="14" Foreground="White" Glyph="{x:Bind t:Icons.Check}" />
            </Border>
            <Border x:Name="OfflineBadge" Width="20" Height="20" CornerRadius="10" Background="#8C000000" Margin="6,6,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed">
                <FontIcon Style="{StaticResource LwIcon}" FontSize="12" Foreground="White" Glyph="{x:Bind t:Icons.Download}" />
            </Border>
            <Border x:Name="CountBadge" MinWidth="20" Height="20" Padding="6,0" CornerRadius="10" Background="{StaticResource LwAccentBrush}"
                    Margin="0,6,6,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                <TextBlock x:Name="CountText" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <Grid x:Name="ProgressTrack" Height="4" Margin="8,0,8,7" VerticalAlignment="Bottom" CornerRadius="2" Background="#38FFFFFF" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ProgressDone" Width="*" />
                    <ColumnDefinition x:Name="ProgressLeft" Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ProgressFill" CornerRadius="2" Background="{StaticResource LwAccentFgBrush}" />
            </Grid>
            <Button x:Name="PlayButton" Style="{StaticResource LwAccentButton}" Width="44" Height="44" Padding="0" CornerRadius="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" Visibility="Collapsed"
                    AutomationProperties.AutomationId="CardPlay" Click="OnPlay">
                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Play}" />
            </Button>
            <Border x:Name="Actions" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6" Padding="2"
                    CornerRadius="6" Background="#B8121214" BorderBrush="#14FFFFFF" BorderThickness="1" Opacity="0" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button x:Name="WatchedButton" Style="{StaticResource LwSubtleButton}" Width="28" Height="26" Foreground="White"
                            AutomationProperties.AutomationId="CardMarkWatched" Click="OnToggleWatched">
                        <FontIcon Style="{StaticResource LwIcon}" FontSize="17" Glyph="{x:Bind t:Icons.Check}" />
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource LwSubtleButton}" Width="28" Height="26" Foreground="White"
                            AutomationProperties.AutomationId="CardMore" Click="OnMore">
                        <FontIcon Style="{StaticResource LwIcon}" Glyph="{x:Bind t:Icons.MoreHoriz}" />
                    </Button>
                </StackPanel>
            </Border>
        </c:AspectGrid>
        <StackPanel x:Name="Caption" Spacing="2" Padding="2,0">
            <TextBlock x:Name="TitleText" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{StaticResource LwTextBrush}" />
            <TextBlock x:Name="SubText" FontSize="11.5" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                       Foreground="{StaticResource LwText2Brush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
