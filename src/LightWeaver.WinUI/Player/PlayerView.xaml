<?xml version="1.0" encoding="utf-8"?>
<!-- The player's controls over the video (design 13): title and Back on top, the transport bar at
     the bottom (seek bar with chapters, buffer and trickplay; play/pause, back, forward, next,
     volume; RTX VSR and RTX HDR, audio and subtitles, quality, speed, queue, info, full screen), Skip
     intro, the Up Next card and the volume readout. Where the row is too narrow for both groups, audio
     and subtitles fold into one Tracks button (13c). Clicking the position opens a field in its place to type one.
     Flyouts open inside the window above the bar. After 2.5 s without input during playback the
     controls and the cursor hide; they stay while paused or while a flyout is open. -->
<UserControl
    x:Class="LightWeaver.WinUI.Player.PlayerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    xmlns:c="using:LightWeaver.WinUI.Controls"
    IsTabStop="True" AutomationProperties.AutomationId="PlayerView">

    <Grid x:Name="Root" Background="Transparent" PointerMoved="OnPointerMoved" PointerExited="OnPointerExited" PointerPressed="OnVideoPressed" DoubleTapped="OnVideoDoubleTapped">
        <Grid x:Name="Chrome">
            <Grid x:Name="TopArea" VerticalAlignment="Top" Height="110" IsHitTestVisible="True">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#B3000000" />
                        <GradientStop Offset="1" Color="#00000000" />
                    </LinearGradientBrush>
                </Grid.Background>
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="16,14,16,0" VerticalAlignment="Top">
                    <Button x:Name="BackButton" Style="{StaticResource LwSubtleButton}" Width="36" Height="36" Foreground="White" Click="OnBack"
                            AutomationProperties.AutomationId="PlayerBack">
                        <FontIcon Style="{StaticResource LwDirectionalIcon}" FontSize="18" Glyph="{x:Bind t:Icons.ArrowBack}" />
                    </Button>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Foreground="White" AutomationProperties.AutomationId="PlayerTitle" />
                        <TextBlock x:Name="SubtitleText" FontSize="12.5" Foreground="#C7FFFFFF" AutomationProperties.AutomationId="PlayerSubtitle" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border x:Name="Transport" VerticalAlignment="Bottom" Background="#94000000" Padding="16,6,16,10">
                <Grid RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="12" FlowDirection="LeftToRight">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Button x:Name="PositionButton" Style="{StaticResource LwSubtleButton}" Padding="4,0" Foreground="#E0FFFFFF" Click="OnTimeEditBegin"
                                    AutomationProperties.AutomationId="PlayerPositionButton">
                                <TextBlock x:Name="PositionText" FontSize="12" AutomationProperties.AutomationId="PlayerPosition" />
                            </Button>
                            <Border x:Name="TimeEditFrame" Width="76" Height="24" Visibility="Collapsed" Background="#8C000000" BorderBrush="#33FFFFFF" BorderThickness="1"
                                    CornerRadius="{StaticResource LwControlRadius}">
                                <TextBox x:Name="TimeEditBox" Style="{StaticResource LwBareTextBox}" FontSize="12" Foreground="White" Padding="6,0" IsSpellCheckEnabled="False"
                                         KeyDown="OnTimeEditKeyDown" LostFocus="OnTimeEditLostFocus" AutomationProperties.AutomationId="PlayerTimeEdit" />
                            </Border>
                        </Grid>
                        <Grid x:Name="SeekArea" Grid.Column="1" Height="28" Background="Transparent"
                              PointerMoved="OnSeekHover" PointerExited="OnSeekExited">
                            <Grid x:Name="TrackLayer" Height="4" VerticalAlignment="Center" IsHitTestVisible="False">
                                <Border x:Name="TrackBase" CornerRadius="2" Background="#38FFFFFF" />
                                <Border x:Name="BufferedBar" CornerRadius="2" Background="#59FFFFFF" HorizontalAlignment="Left" Width="0" />
                                <Border x:Name="PlayedBar" CornerRadius="2" Background="{StaticResource LwAccentFgBrush}" HorizontalAlignment="Left" Width="0" />
                                <Canvas x:Name="ChapterGaps" />
                            </Grid>
                            <Slider x:Name="SeekSlider" Minimum="0" Maximum="1" StepFrequency="1" IsThumbToolTipEnabled="False" Opacity="0.01"
                                    VerticalAlignment="Center" ValueChanged="OnSeekChanged" PointerCaptureLost="OnSeekReleased"
                                    AutomationProperties.AutomationId="PlayerSeek" />
                        </Grid>
                        <Button x:Name="TimeButton" Grid.Column="2" Style="{StaticResource LwSubtleButton}" Padding="4,0" Foreground="#E0FFFFFF" Click="OnTimeToggle"
                                AutomationProperties.AutomationId="PlayerTime">
                            <TextBlock x:Name="RemainingText" FontSize="12" />
                        </Button>
                    </Grid>
                    <c:BarRow x:Name="ButtonRow" Grid.Row="1" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button x:Name="PlayPauseButton" Style="{StaticResource LwSubtleButton}" Width="40" Height="38" Foreground="White" Click="OnPlayPause"
                                    AutomationProperties.AutomationId="PlayerPlayPause">
                                <FontIcon x:Name="PlayPauseIcon" Style="{StaticResource LwIcon}" FontSize="20" Glyph="{x:Bind t:Icons.Pause}" />
                            </Button>
                            <Button x:Name="JumpBackButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnJumpBack"
                                    AutomationProperties.AutomationId="PlayerJumpBack">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.SkipBack10}" />
                            </Button>
                            <Button x:Name="JumpForwardButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnJumpForward"
                                    AutomationProperties.AutomationId="PlayerJumpForward">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.SkipForward30}" />
                            </Button>
                            <Button x:Name="NextButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnNext"
                                    AutomationProperties.AutomationId="PlayerNext">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Next}" />
                            </Button>
                            <Button x:Name="MuteButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnMute"
                                    AutomationProperties.AutomationId="PlayerMute">
                                <FontIcon x:Name="MuteIcon" Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Volume}" />
                            </Button>
                            <Slider x:Name="VolumeSlider" Width="96" Minimum="0" Maximum="100" StepFrequency="1" VerticalAlignment="Center"
                                    IsThumbToolTipEnabled="False" ValueChanged="OnVolumeChanged" AutomationProperties.AutomationId="PlayerVolume" />
                        </StackPanel>
                        <c:WrapPanel x:Name="EndGroup" HorizontalSpacing="2" VerticalSpacing="2">
                            <ToggleButton x:Name="VsrToggle" Style="{StaticResource LwBarToggle}" AllowFocusOnInteraction="False" Click="OnVsrToggle"
                                          AutomationProperties.AutomationId="PlayerVsrToggle" />
                            <ToggleButton x:Name="RtxHdrToggle" Style="{StaticResource LwBarToggle}" AllowFocusOnInteraction="False" Click="OnRtxHdrToggle"
                                          AutomationProperties.AutomationId="PlayerRtxHdrToggle" />
                            <Button x:Name="TracksButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnTracks"
                                    Visibility="Collapsed" AutomationProperties.AutomationId="PlayerTracks">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Subtitles}" />
                            </Button>
                            <Button x:Name="AudioButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnAudioTracks"
                                    AutomationProperties.AutomationId="PlayerAudioTracks">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.AudioTrack}" />
                            </Button>
                            <Button x:Name="SubtitlesButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnSubtitleTracks"
                                    AutomationProperties.AutomationId="PlayerSubtitleTracks">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Subtitles}" />
                            </Button>
                            <Button x:Name="QualityButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnQuality"
                                    AutomationProperties.AutomationId="PlayerQuality">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Settings}" />
                            </Button>
                            <Button x:Name="SpeedButton" Style="{StaticResource LwSubtleButton}" MinWidth="44" Height="38" Padding="6,0" Foreground="White" Click="OnSpeed"
                                    AutomationProperties.AutomationId="PlayerSpeed">
                                <TextBlock x:Name="SpeedText" FontSize="13" FontWeight="SemiBold" />
                            </Button>
                            <Button x:Name="QueueButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnQueue"
                                    AutomationProperties.AutomationId="PlayerQueue">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.List}" />
                            </Button>
                            <Button x:Name="InfoButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnInfo"
                                    AutomationProperties.AutomationId="PlayerInfo">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Info}" />
                            </Button>
                            <Button x:Name="FullscreenButton" Style="{StaticResource LwSubtleButton}" Width="38" Height="38" Foreground="White" Click="OnFullscreen"
                                    AutomationProperties.AutomationId="PlayerFullscreen">
                                <FontIcon x:Name="FullscreenIcon" Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.FullScreen}" />
                            </Button>
                        </c:WrapPanel>
                    </c:BarRow>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" FontSize="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   AutomationProperties.AutomationId="PlayerStatus" />

        <Border x:Name="FailurePanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Margin="24" Padding="24,20"
                Visibility="Collapsed" Background="#B8000000" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <FontIcon Style="{StaticResource LwIcon}" FontSize="20" Glyph="{x:Bind t:Icons.ErrorSolid}" Foreground="#FF99A4" />
                    <TextBlock x:Name="FailureTitle" FontSize="17" FontWeight="SemiBold" Foreground="White" AutomationProperties.AutomationId="PlayerFailureTitle" />
                </StackPanel>
                <TextBlock x:Name="FailureMessage" FontSize="13" Foreground="#E0FFFFFF" TextWrapping="Wrap" LineHeight="20"
                           AutomationProperties.AutomationId="PlayerFailureMessage" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                    <Button x:Name="FailureRetry" Style="{StaticResource LwAccentButton}" Padding="16,0" Click="OnFailureRetry"
                            AutomationProperties.AutomationId="PlayerFailureRetry">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource LwIcon}" FontSize="15" Glyph="{x:Bind t:Icons.Refresh}" />
                            <TextBlock x:Name="FailureRetryText" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FailureOther" Style="{StaticResource LwButton}" Click="OnFailureAlternative"
                            AutomationProperties.AutomationId="PlayerFailureAlternative" />
                    <Button x:Name="FailureDetailsButton" Style="{StaticResource LwSubtleButton}" Foreground="#C7FFFFFF" Click="OnFailureDetails"
                            AutomationProperties.AutomationId="PlayerFailureDetails" />
                </StackPanel>
                <Grid x:Name="FailureDetails" ColumnSpacing="8" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="FailureReason" FontSize="12" Foreground="#C7FFFFFF" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                               FontFamily="Consolas" AutomationProperties.AutomationId="PlayerFailureReason" />
                    <Button x:Name="FailureCopy" Grid.Column="1" Style="{StaticResource LwSubtleButton}" Foreground="#E0FFFFFF" VerticalAlignment="Top"
                            Click="OnFailureCopy" AutomationProperties.AutomationId="PlayerFailureCopy">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource LwIcon}" FontSize="14" Glyph="{x:Bind t:Icons.Copy}" />
                            <TextBlock x:Name="FailureCopyText" FontSize="12" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Button x:Name="SkipButton" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120" Padding="16,8" Visibility="Collapsed"
                Background="#A8000000" Foreground="White" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Click="OnSkip"
                AutomationProperties.AutomationId="PlayerSkip">
            <TextBlock x:Name="SkipText" FontSize="14" FontWeight="SemiBold" />
        </Button>

        <Border x:Name="UpNextCard" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,120" Width="340" Padding="12" Visibility="Collapsed"
                Background="#C7121214" BorderBrush="#24FFFFFF" BorderThickness="1" CornerRadius="8">
            <Grid ColumnSpacing="12" RowSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Border Width="112" Height="63" CornerRadius="4" Background="{StaticResource LwPlaceholderBrush}">
                    <Image x:Name="UpNextImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock x:Name="UpNextLabel" FontSize="11.5" Foreground="{StaticResource LwAccentFgBrush}" />
                    <TextBlock x:Name="UpNextTitle" FontSize="13.5" FontWeight="SemiBold" Foreground="White" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="PlayerUpNextTitle" />
                    <TextBlock x:Name="UpNextSubtitle" FontSize="12" Foreground="#C7FFFFFF" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="UpNextCountdown" FontSize="12" Foreground="#C7FFFFFF" AutomationProperties.AutomationId="PlayerUpNextCountdown" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button x:Name="UpNextCancel" Style="{StaticResource LwButton}" Click="OnUpNextCancel" AutomationProperties.AutomationId="PlayerUpNextCancel" />
                    <Button x:Name="UpNextPlay" Style="{StaticResource LwAccentButton}" Click="OnUpNextPlay" AutomationProperties.AutomationId="PlayerUpNextPlay" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- The volume readout: top right, opposite the toasts, shown by every change to the level or
             mute and independent of the controls. Collapsed until shown, so UI Automation presence
             means visible. -->
        <Border x:Name="VolumePill" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,72,16,0" MinHeight="36" Padding="12,0,14,1"
                Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="{StaticResource LwGroupRadius}"
                Background="{StaticResource LwPlayerGlassBrush}" BorderBrush="{StaticResource LwPlayerGlassBorderBrush}" BorderThickness="1"
                Translation="0,0,24">
            <Border.Shadow>
                <ThemeShadow />
            </Border.Shadow>
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon x:Name="VolumePillIcon" Style="{StaticResource LwIcon}" FontSize="16" Foreground="{StaticResource LwPlayerTextBrush}"
                          Glyph="{x:Bind t:Icons.Volume}" AutomationProperties.AutomationId="PlayerVolumeIndicatorGlyph" />
                <TextBlock x:Name="VolumePillText" FontSize="13" MinWidth="34" TextAlignment="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource LwPlayerTextBrush}" AutomationProperties.AutomationId="PlayerVolumeIndicator" />
            </StackPanel>
        </Border>

        <Popup x:Name="TrickplayPopup" IsLightDismissEnabled="False" ShouldConstrainToRootBounds="True">
            <Border x:Name="TrickplayCard" Background="#E0121214" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="6" Padding="4">
                <StackPanel Spacing="4">
                    <Border x:Name="ThumbFrame" CornerRadius="3" Background="#FF0B0B0D" Visibility="Collapsed">
                        <Canvas x:Name="ThumbCanvas">
                            <Image x:Name="ThumbSheet" Stretch="None" />
                        </Canvas>
                    </Border>
                    <TextBlock x:Name="HoverTime" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HoverChapter" FontSize="11.5" Foreground="#C7FFFFFF" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
