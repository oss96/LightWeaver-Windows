<?xml version="1.0" encoding="utf-8"?>
<!-- Server unreachable (design 14a): replaces a server-backed page. The banner counts down to the
     next automatic retry; Retry tries now; Details shows the technical reason; downloaded titles
     stay playable in the "Available offline" row. -->
<UserControl
    x:Class="LightWeaver.WinUI.Shell.ServerUnreachableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LightWeaver.WinUI.Localization"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    AutomationProperties.AutomationId="ServerUnreachable">

    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <InfoBar x:Name="Banner" Severity="Warning" IsOpen="True" IsClosable="False" Margin="24,12,24,0"
                 AutomationProperties.AutomationId="OfflineBanner" />
        <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
            <FontIcon FontFamily="{StaticResource LwIconFont}" FontSize="48" Glyph="{x:Bind t:Icons.Cloud}" Foreground="{StaticResource LwText3Brush}" />
            <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0"
                       TextAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="UnreachableTitle" />
            <TextBlock x:Name="MessageText" FontSize="13" Foreground="{StaticResource LwText2Brush}" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="420" LineHeight="20" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button Style="{StaticResource LwAccentButton}" Padding="16,0" Click="OnRetry" AutomationProperties.AutomationId="RetryButton">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Style="{StaticResource LwIcon}" FontSize="15" Glyph="{x:Bind t:Icons.Refresh}" />
                        <TextBlock Text="{loc:Text Key=Errors.Retry}" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource LwButton}" Content="{loc:Text Key=Errors.SwitchServer}" Click="OnSwitchServer"
                        AutomationProperties.AutomationId="SwitchServerButton" />
                <Button Style="{StaticResource LwButton}" Content="{loc:Text Key=Errors.OpenDownloads}" Click="OnOpenDownloads"
                        AutomationProperties.AutomationId="OpenDownloadsButton" />
            </StackPanel>
            <Button x:Name="DetailsButton" Style="{StaticResource LwSubtleButton}" HorizontalAlignment="Center" Padding="6,2"
                    Foreground="{StaticResource LwText3Brush}" Click="OnDetails" AutomationProperties.AutomationId="DetailsButton">
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon x:Name="DetailsChevron" Style="{StaticResource LwDirectionalIcon}" FontSize="12" Glyph="{x:Bind t:Icons.ChevronRightSmall}" />
                    <TextBlock x:Name="DetailsText" FontSize="12" TextWrapping="Wrap" MaxWidth="480" />
                </StackPanel>
            </Button>
        </StackPanel>
        <StackPanel x:Name="OfflineRow" Grid.Row="2" Margin="24,0,24,24" />
    </Grid>
</UserControl>
