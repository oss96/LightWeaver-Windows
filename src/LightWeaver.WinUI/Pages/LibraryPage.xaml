<?xml version="1.0" encoding="utf-8"?>
<!-- Library grid (design 02): poster grid of one library with a watched filter, a multi-select
     genre filter, sort (key and order), display options (poster size, titles) and an A–Z rail on
     the trailing edge while sorted by name. The toolbar wraps under the title when it does not
     fit beside it. A collection (box set) lists its titles in the same grid. -->
<UserControl
    x:Class="LightWeaver.WinUI.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LightWeaver.WinUI.Controls"
    xmlns:loc="using:LightWeaver.WinUI.Localization"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    AutomationProperties.AutomationId="LibraryPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="Header" Padding="24,14,24,14" ColumnSpacing="12" RowSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel x:Name="TitleBlock" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="26" FontWeight="Bold" CharacterSpacing="-10" AutomationProperties.HeadingLevel="Level1"
                           AutomationProperties.AutomationId="LibraryTitle" />
                <TextBlock x:Name="CountText" FontSize="13" Foreground="{StaticResource LwText2Brush}" VerticalAlignment="Bottom" Margin="0,0,0,5"
                           AutomationProperties.AutomationId="LibraryCount" />
                <ProgressRing x:Name="LoadingRing" Width="14" Height="14" MinWidth="0" MinHeight="0" IsActive="False" VerticalAlignment="Bottom" Margin="0,0,0,6"
                              Foreground="{StaticResource LwAccentFgBrush}" AutomationProperties.AutomationId="LibraryLoading" />
            </StackPanel>
            <StackPanel x:Name="Toolbar" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Style="{StaticResource LwSegmentTrack}">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="WatchedAll" Style="{StaticResource LwSegment}" GroupName="LibraryWatched" Padding="12,0" IsChecked="True"
                                     Content="{loc:Text Key=Library.WatchedAll}" Checked="OnWatchedChecked" AutomationProperties.AutomationId="LibraryWatchedAll" />
                        <RadioButton x:Name="WatchedUnplayed" Style="{StaticResource LwSegment}" GroupName="LibraryWatched" Padding="12,0"
                                     Content="{loc:Text Key=Library.WatchedUnplayed}" Checked="OnWatchedChecked" AutomationProperties.AutomationId="LibraryWatchedUnplayed" />
                        <RadioButton x:Name="WatchedPlayed" Style="{StaticResource LwSegment}" GroupName="LibraryWatched" Padding="12,0"
                                     Content="{loc:Text Key=Library.WatchedPlayed}" Checked="OnWatchedChecked" AutomationProperties.AutomationId="LibraryWatchedPlayed" />
                    </StackPanel>
                </Border>
                <Button x:Name="GenreButton" Style="{StaticResource LwButton}" Padding="10,0,8,0" Click="OnGenres" AutomationProperties.AutomationId="LibraryGenre">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock x:Name="GenreText" FontSize="12.5" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                        <FontIcon Style="{StaticResource LwIcon}" Foreground="{StaticResource LwText2Brush}" Glyph="{x:Bind t:Icons.ExpandMore}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SortButton" Style="{StaticResource LwButton}" Padding="10,0,8,0" Click="OnSort" AutomationProperties.AutomationId="LibrarySort">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SortArrow" Style="{StaticResource LwIcon}" Glyph="{x:Bind t:Icons.ArrowUpward}" />
                        <TextBlock x:Name="SortText" FontSize="12.5" VerticalAlignment="Center" />
                        <FontIcon Style="{StaticResource LwIcon}" Foreground="{StaticResource LwText2Brush}" Glyph="{x:Bind t:Icons.ExpandMore}" />
                    </StackPanel>
                </Button>
                <Button x:Name="DisplayButton" Style="{StaticResource LwButton}" Width="32" Padding="0" Click="OnDisplay" AutomationProperties.AutomationId="LibraryDisplay">
                    <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.GridView}" />
                </Button>
            </StackPanel>
        </Grid>

        <c:WrapPanel x:Name="ChipRow" Grid.Row="1" HorizontalSpacing="6" VerticalSpacing="6" Margin="24,0,24,0" />

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="Scroller" Padding="24,0,12,24" HorizontalScrollMode="Disabled" AutomationProperties.AutomationId="LibraryScroller">
                <ItemsRepeater x:Name="Items" ElementPrepared="OnElementPrepared" VerticalCacheLength="1">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="GridLayout" MinColumnSpacing="14" MinRowSpacing="20" ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <c:MediaCard />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <ScrollViewer x:Name="SkeletonScroller" Padding="24,0,12,24" Visibility="Collapsed" IsHitTestVisible="False" VerticalScrollBarVisibility="Hidden">
                <ItemsRepeater x:Name="Skeleton">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout x:Name="SkeletonLayout" MinColumnSpacing="14" MinRowSpacing="20" ItemsStretch="Uniform" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="{StaticResource LwCardRadius}" Background="{StaticResource LwPlaceholderBrush}" Margin="0,0,0,44" />
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
            <c:AlphaRail x:Name="Rail" Grid.Column="1" Margin="0,0,8,24" Jump="OnRailJump" />

            <StackPanel x:Name="EmptyState" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,90" Visibility="Collapsed">
                <FontIcon x:Name="EmptyIcon" FontFamily="{StaticResource LwIconFont}" FontSize="44" Foreground="{StaticResource LwText3Brush}" Glyph="{x:Bind t:Icons.FilterAltOff}" />
                <TextBlock x:Name="EmptyTitle" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" AutomationProperties.AutomationId="LibraryEmptyTitle" />
                <TextBlock x:Name="EmptyText" FontSize="13" Foreground="{StaticResource LwText2Brush}" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="420" />
                <Button x:Name="ClearFiltersButton" Style="{StaticResource LwAccentButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnClearFilters"
                        Content="{loc:Text Key=Library.ClearFilters}" AutomationProperties.AutomationId="LibraryClearFilters" />
                <HyperlinkButton x:Name="DashboardLink" HorizontalAlignment="Center" Content="{loc:Text Key=Library.OpenDashboard}" Foreground="{StaticResource LwAccentFgBrush}"
                                 AutomationProperties.AutomationId="LibraryDashboard" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
