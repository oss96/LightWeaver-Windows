<?xml version="1.0" encoding="utf-8"?>
<!-- Person page (design 07): photo, name, roles, birth and a bio clamped to six lines with More in
     place on a fixed left column; the filmography scrolls on the right as a grid per role, with a
     role filter (counts) and a sort. Below 1000 px the column narrows to 200 px and the bio clamps
     to four lines. -->
<UserControl
    x:Class="LightWeaver.WinUI.Pages.PersonPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:LightWeaver.WinUI.Localization"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    AutomationProperties.AutomationId="PersonPage">

    <Grid x:Name="Body" Padding="24,20,24,0" ColumnSpacing="32">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ScrollViewer HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden">
            <StackPanel Spacing="12" Padding="0,0,0,24">
                <Grid x:Name="PhotoFrame" CornerRadius="{StaticResource LwCardRadius}" Background="{StaticResource LwPlaceholderBrush}">
                    <Image x:Name="Photo" Stretch="UniformToFill" />
                </Grid>
                <StackPanel Spacing="4" Margin="0,4,0,0">
                    <TextBlock x:Name="NameText" FontSize="26" FontWeight="Bold" CharacterSpacing="-10" TextWrapping="WrapWholeWords"
                               AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PersonName" />
                    <TextBlock x:Name="RolesText" FontSize="13" Foreground="{StaticResource LwText2Brush}" TextWrapping="WrapWholeWords"
                               AutomationProperties.AutomationId="PersonRoles" />
                    <TextBlock x:Name="BornText" FontSize="12.5" Foreground="{StaticResource LwText3Brush}" TextWrapping="WrapWholeWords"
                               AutomationProperties.AutomationId="PersonBorn" />
                </StackPanel>
                <TextBlock x:Name="BioText" FontSize="13" LineHeight="20" TextWrapping="WrapWholeWords" TextTrimming="CharacterEllipsis" MaxLines="6"
                           TextReadingOrder="DetectFromContent" TextAlignment="DetectFromContent"
                           Foreground="{StaticResource LwText2Brush}" AutomationProperties.AutomationId="PersonBio" />
                <HyperlinkButton x:Name="BioMore" Padding="0" FontSize="12.5" Visibility="Collapsed" Click="OnBioMore"
                                 Foreground="{StaticResource LwAccentFgBrush}" AutomationProperties.AutomationId="PersonBioMore" />
                <Button x:Name="AdvancedButton" Style="{StaticResource LwButton}" Padding="10,0,12,0" Click="OnAdvanced" HorizontalAlignment="Left"
                        AutomationProperties.AutomationId="PersonAdvancedSearch">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Style="{StaticResource LwIcon}" FontSize="15" Glyph="{x:Bind t:Icons.Tune}" />
                        <TextBlock Text="{loc:Text Key=Search.AdvancedSearch}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Column="1" RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Text="{loc:Text Key=Person.Filmography}"
                           AutomationProperties.AutomationId="PersonFilmography" />
                <Border x:Name="RoleTrack" Grid.Column="1" Style="{StaticResource LwSegmentTrack}">
                    <StackPanel x:Name="RoleFilter" Orientation="Horizontal" />
                </Border>
                <Button x:Name="SortButton" Grid.Column="2" Style="{StaticResource LwButton}" Padding="10,0,8,0" Click="OnSort"
                        AutomationProperties.AutomationId="PersonSort">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="SortArrow" Style="{StaticResource LwIcon}" Glyph="{x:Bind t:Icons.ArrowDownward}" />
                        <TextBlock x:Name="SortText" FontSize="12.5" VerticalAlignment="Center" />
                        <FontIcon Style="{StaticResource LwIcon}" Foreground="{StaticResource LwText2Brush}" Glyph="{x:Bind t:Icons.ExpandMore}" />
                    </StackPanel>
                </Button>
            </Grid>
            <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled"
                          AutomationProperties.AutomationId="PersonScroller">
                <StackPanel x:Name="Sections" Spacing="18" Padding="0,0,0,24" />
            </ScrollViewer>
            <TextBlock x:Name="EmptyText" Grid.Row="1" FontSize="13" Foreground="{StaticResource LwText2Brush}" Visibility="Collapsed"
                       Text="{loc:Text Key=Person.NoCredits}" AutomationProperties.AutomationId="PersonEmpty" />
        </Grid>
    </Grid>
</UserControl>
