<?xml version="1.0" encoding="utf-8"?>
<!-- Playlist page (design 06, 6b to 6e): art, name and summary with Play all, Shuffle and ⋯ (Rename,
     Delete playlist); then the items as rows with number, thumbnail, title, type and duration.
     Hovering a row swaps the number for a drag handle and shows Remove and ⋯. Double-click or Enter
     plays from that row; Delete removes the selected rows with Undo; Ctrl- and Shift-click select
     several; drag or Alt+Up/Down reorders. Below 1000 px the art shrinks to 120 px. -->
<UserControl
    x:Class="LightWeaver.WinUI.Pages.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LightWeaver.WinUI.Pages"
    xmlns:loc="using:LightWeaver.WinUI.Localization"
    xmlns:t="using:LightWeaver.WinUI.Theme"
    AutomationProperties.AutomationId="PlaylistPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="24,20,24,18" ColumnSpacing="22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="Art" Width="168" Height="168" CornerRadius="{StaticResource LwCardRadius}" Background="{StaticResource LwPlaceholderBrush}" VerticalAlignment="Bottom">
                <FontIcon Style="{StaticResource LwIcon}" FontSize="40" Foreground="{StaticResource LwText3Brush}" Glyph="{x:Bind t:Icons.PlaylistPlay}" />
                <Image x:Name="ArtImage" Stretch="UniformToFill" />
            </Grid>
            <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
                <TextBlock FontSize="12" FontWeight="Medium" Foreground="{StaticResource LwText2Brush}" Text="{loc:Text Key=Playlist.Eyebrow}" />
                <TextBlock x:Name="TitleText" FontSize="34" FontWeight="Bold" CharacterSpacing="-10" TextTrimming="CharacterEllipsis"
                           AutomationProperties.HeadingLevel="Level1" AutomationProperties.AutomationId="PlaylistTitle" />
                <TextBlock x:Name="MetaText" FontSize="13" Foreground="{StaticResource LwText2Brush}" AutomationProperties.AutomationId="PlaylistMeta" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                    <Button x:Name="PlayAllButton" Style="{StaticResource LwAccentButton}" Height="32" Padding="12,0,16,0" Click="OnPlayAll"
                            AutomationProperties.AutomationId="PlaylistPlayAll">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource LwIcon}" FontSize="16" Glyph="{x:Bind t:Icons.Play}" />
                            <TextBlock Text="{loc:Text Key=Playlist.PlayAll}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="ShuffleButton" Style="{StaticResource LwButton}" Height="32" Padding="12,0,14,0" Click="OnShuffle"
                            AutomationProperties.AutomationId="PlaylistShuffle">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Style="{StaticResource LwIcon}" FontSize="16" Glyph="{x:Bind t:Icons.Shuffle}" />
                            <TextBlock Text="{loc:Text Key=Playlist.Shuffle}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MoreButton" Style="{StaticResource LwButton}" Width="32" Height="32" Padding="0" Click="OnMore"
                            AutomationProperties.AutomationId="PlaylistMore">
                        <FontIcon Style="{StaticResource LwIcon}" FontSize="16" Glyph="{x:Bind t:Icons.MoreHoriz}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24,0" Height="30" Padding="12,0" ColumnSpacing="14" BorderBrush="{StaticResource LwSeparatorBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="96" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="70" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="#" Style="{StaticResource LwColumnHeader}" HorizontalAlignment="Right" />
            <TextBlock Grid.Column="2" Style="{StaticResource LwColumnHeader}" Text="{loc:Text Key=Playlist.ColumnTitle}" />
            <TextBlock Grid.Column="3" Style="{StaticResource LwColumnHeader}" Text="{loc:Text Key=Playlist.ColumnType}" />
            <TextBlock Grid.Column="4" Style="{StaticResource LwColumnHeader}" HorizontalAlignment="Right" Text="{loc:Text Key=Playlist.ColumnDuration}" />
        </Grid>

        <ListView x:Name="Rows" Grid.Row="2" Padding="24,4,24,24" SelectionMode="Extended" IsItemClickEnabled="False"
                  CanReorderItems="True" CanDragItems="True" AllowDrop="True" DragItemsCompleted="OnDragCompleted"
                  DoubleTapped="OnRowsDoubleTapped" KeyDown="OnRowsKeyDown" AutomationProperties.AutomationId="PlaylistList">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="MinHeight" Value="62" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:PlaylistRow">
                    <Grid Height="62" Padding="12,0" ColumnSpacing="14" Background="Transparent" PointerEntered="OnRowEntered" PointerExited="OnRowExited">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="96" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="64" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Number, Mode=OneWay}" Visibility="{x:Bind ShowNumber, Mode=OneWay}" FontSize="13"
                                   Foreground="{StaticResource LwText2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.Drag}" Visibility="{x:Bind Hovered, Mode=OneWay}"
                                  Foreground="{StaticResource LwText2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Width="96" Height="54" CornerRadius="4" Background="{StaticResource LwPlaceholderBrush}">
                            <Image Source="{x:Bind Thumb, Mode=OneWay}" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Grid.Column="2" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Title}" FontSize="13.5" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="{StaticResource LwText2Brush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{x:Bind Type}" FontSize="12.5" Foreground="{StaticResource LwText2Brush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" FontSize="12.5" Foreground="{StaticResource LwText2Brush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" Opacity="{x:Bind ActionsOpacity, Mode=OneWay}">
                            <Button Style="{StaticResource LwSubtleButton}" Width="28" Height="28" Tag="{x:Bind}" Click="OnRowRemove"
                                    Foreground="{StaticResource LwText2Brush}" AutomationProperties.AutomationId="PlaylistRowRemove"
                                    AutomationProperties.Name="{x:Bind RemoveLabel}" ToolTipService.ToolTip="{x:Bind RemoveLabel}">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.RemoveCircle}" />
                            </Button>
                            <Button Style="{StaticResource LwSubtleButton}" Width="28" Height="28" Tag="{x:Bind}" Click="OnRowMore"
                                    Foreground="{StaticResource LwText2Brush}" AutomationProperties.AutomationId="PlaylistRowMore"
                                    AutomationProperties.Name="{x:Bind MoreLabel}" ToolTipService.ToolTip="{x:Bind MoreLabel}">
                                <FontIcon Style="{StaticResource LwIcon}" FontSize="18" Glyph="{x:Bind t:Icons.MoreHoriz}" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="Empty" Grid.Row="2" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,0,80">
            <TextBlock FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{loc:Text Key=Playlist.EmptyTitle}"
                       AutomationProperties.AutomationId="PlaylistEmpty" />
            <TextBlock FontSize="13" Foreground="{StaticResource LwText2Brush}" HorizontalAlignment="Center" TextWrapping="WrapWholeWords" MaxWidth="360"
                       TextAlignment="Center" Text="{loc:Text Key=Playlist.EmptyHint}" />
        </StackPanel>
    </Grid>
</UserControl>
