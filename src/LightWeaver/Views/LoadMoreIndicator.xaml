<UserControl x:Class="LightWeaver.Views.LoadMoreIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LightWeaver.Views"
             IsHitTestVisible="False">
    <!-- The "more is coming" pill (2026-08-02). Shown while an infinite-scroll grid appends
         its next page. Deliberately NOT a skeleton: the grid is already full of real cards
         and the append lands below the fold, so there is no empty silhouette to stand in for
         - what the user needs to know is that the bottom of the list is not the end of it.

         Hit-test invisible so it can float over the last card row without eating clicks. -->
    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom"
            Background="{StaticResource LwStorm3Brush}"
            CornerRadius="{StaticResource LwR2}"
            Effect="{StaticResource LwElevation2}"
            Padding="14,8" Margin="0,0,0,18">
        <StackPanel Orientation="Horizontal">
            <local:ActivityDots VerticalAlignment="Center" />
            <!-- Visible text has its own UIA peer, so the id rides the caption directly -
                 no transparent marker needed here (unlike the Border/Panel cases). -->
            <TextBlock x:Name="Caption" Text="Loading more…"
                       FontFamily="{StaticResource LwFontUi}" FontSize="13"
                       Foreground="{StaticResource LwText2Brush}"
                       VerticalAlignment="Center" Margin="10,0,0,0"
                       AutomationProperties.AutomationId="LoadMoreSpinner" />
        </StackPanel>
    </Border>
</UserControl>
