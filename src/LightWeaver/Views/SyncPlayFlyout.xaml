<UserControl x:Class="LightWeaver.Views.SyncPlayFlyout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LightWeaver.Localization"
        Width="360" Height="440" Focusable="True"
        Foreground="{StaticResource LwText1Brush}" FontFamily="{StaticResource LwFontUi}"
        AutomationProperties.AutomationId="SyncPlayFlyout">
    <Border Style="{StaticResource LwFlyoutBorder}" Padding="18" Margin="4">
        <DockPanel>
            <Button DockPanel.Dock="Bottom" Content="{loc:Text SyncPlayFlyout.Close.319a2f71}" Style="{StaticResource LwButtonGhost}"
                    HorizontalAlignment="Right" Margin="0,14,0,0" Click="OnClose"
                    AutomationProperties.AutomationId="SyncPlayClose" />
            <TextBlock DockPanel.Dock="Top" Text="{loc:Text SyncPlayFlyout.Syncplay.fd084776}" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,12"
                       Foreground="{StaticResource LwText2Brush}" AutomationProperties.AutomationId="SyncPlayStatus" />
            <Button x:Name="CancelJoinButton" DockPanel.Dock="Top" Content="{loc:Text SyncPlayFlyout.CancelJoining.b50340ba}"
                    Style="{StaticResource LwButtonSecondary}" HorizontalAlignment="Left" Margin="0,0,0,12"
                    Visibility="Collapsed" Click="OnLeave" AutomationProperties.AutomationId="SyncPlayCancelJoin" />

            <Grid>
                <Grid x:Name="CurrentGroupPanel" Visibility="Collapsed" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="GroupDetailsScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock x:Name="GroupNameText" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="SyncPlayGroupName" />
                            <TextBlock x:Name="GroupStateText" Foreground="{StaticResource LwText2Brush}" Margin="0,5,0,8"
                                       AutomationProperties.AutomationId="SyncPlayGroupState" />
                            <ScrollViewer x:Name="ParticipantsScroll" MinHeight="36" MaxHeight="110"
                                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <TextBlock x:Name="ParticipantsText" TextWrapping="Wrap" Margin="0,0,16,0"
                                           AutomationProperties.AutomationId="SyncPlayParticipants" />
                            </ScrollViewer>
                            <TextBlock Text="{loc:Text SyncPlayFlyout.PlaybackControlsApplyToEveryoneInThe.07666199}" TextWrapping="Wrap"
                                       Foreground="{StaticResource LwText3Brush}" Margin="0,12,0,8" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="LeaveButton" Grid.Row="1" Content="{loc:Text SyncPlayFlyout.LeaveGroup.888a2744}" Style="{StaticResource LwButtonSecondary}"
                            HorizontalAlignment="Left" Margin="0,8,0,0" Click="OnLeave"
                            AutomationProperties.AutomationId="SyncPlayLeave" />
                </Grid>
                <ScrollViewer x:Name="FlyoutBodyScroll" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding Visibility, ElementName=AvailablePanel}">
                    <StackPanel>
                        <DockPanel x:Name="AvailablePanel">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock x:Name="AvailableGroupsLabel" Text="{loc:Text SyncPlayFlyout.AvailableGroups.787650d8}"
                                           FontWeight="SemiBold" TextWrapping="Wrap" />
                                <Button x:Name="RefreshButton" HorizontalAlignment="Right" Margin="0,4,0,0"
                                        Content="{loc:Text SyncPlayFlyout.Refresh.6eda4307}"
                                        Style="{StaticResource LwButtonGhost}" Click="OnRefresh"
                                        AutomationProperties.AutomationId="SyncPlayRefresh" />
                            </StackPanel>
                            <Button x:Name="JoinButton" DockPanel.Dock="Bottom" Content="{loc:Text SyncPlayFlyout.JoinGroup.2b376b91}" Margin="0,10,0,0"
                                    Style="{StaticResource LwButtonPrimary}" HorizontalAlignment="Right" IsEnabled="False"
                                    Click="OnJoin" AutomationProperties.AutomationId="SyncPlayJoin" />
                            <ListBox x:Name="GroupsList" Background="Transparent" BorderThickness="0" MaxHeight="160"
                                     ItemContainerStyle="{StaticResource LwFlyoutListItem}" SelectionChanged="OnSelectionChanged"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="SyncPlayGroups">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,7">
                                            <TextBlock Text="{Binding GroupName}" FontSize="14" TextWrapping="Wrap"
                                                       Foreground="{StaticResource LwText1Brush}" />
                                            <TextBlock Text="{Binding ParticipantLabel}" FontSize="12"
                                                       Foreground="{StaticResource LwText3Brush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                        <StackPanel x:Name="CreatePanel" Margin="0,16,0,0">
                            <TextBlock Text="{loc:Text SyncPlayFlyout.CreateAGroup.16d8b841}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <DockPanel>
                                <Button x:Name="CreateButton" DockPanel.Dock="Right" Content="{loc:Text SyncPlayFlyout.Create.a6d8d3f1}" Margin="8,0,0,0"
                                        Style="{StaticResource LwButtonSecondary}" Click="OnCreate"
                                        AutomationProperties.AutomationId="SyncPlayCreate" />
                                <TextBox x:Name="GroupNameBox" Style="{StaticResource LwTextField}" MaxLength="100"
                                         AutomationProperties.Name="{loc:Text SyncPlayFlyout.NewGroupName.f8af2d3d}" AutomationProperties.AutomationId="SyncPlayNewGroupName" />
                            </DockPanel>
                            <TextBlock Text="{loc:Text SyncPlayFlyout.StartsWithTheCurrentPlaybackQueueIf.fd702128}" TextWrapping="Wrap"
                                       Foreground="{StaticResource LwText3Brush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
