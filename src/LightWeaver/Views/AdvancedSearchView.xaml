<UserControl x:Class="LightWeaver.Views.AdvancedSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:LightWeaver.Views"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="AdvancedSearchView">
    <UserControl.Resources>
        <!-- ASS redesign P11: captions moved off the disabled color (10px LwText4 failed AA)
             to 11.5px SemiBold uppercase UI font in LwText3 (~4.7:1). -->
        <Style TargetType="TextBlock" x:Key="FacetCaption">
            <Setter Property="FontFamily" Value="{StaticResource LwFontUi}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LwText3Brush}" />
            <Setter Property="Margin" Value="2,0,0,5" />
        </Style>
        <!-- Engaged-facet ring: overlaid on a facet whose value is non-default (P9) so
             active filters read at a glance. Non-hit-testable; sits above the control. -->
        <Style TargetType="Border" x:Key="EngagedRing">
            <Setter Property="BorderBrush" Value="{StaticResource LwLightHazeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <!-- P10 M7: height-bound, so the ring matches whatever it is drawn over. As a
                 static LwR2 it was a rounded rect laid on top of stadium facets - the ring
                 has to follow the chrome, not a token. -->
            <Setter Property="CornerRadius"
                    Value="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Effect" Value="{StaticResource LwGlowToggleOn}" />
        </Style>
        <!-- Starter chip (prompt state, P7): stormlight glass pill.
             P10 M5: height-bound radius (h34 -> 17); LwRPill's 999 drew these wide
             text chips as lenses. -->
        <Style TargetType="Button" x:Key="StarterChip">
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource LwLightCoreBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource LwFontUi}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{StaticResource LwChipFillBrush}"
                                BorderBrush="{StaticResource LwChipBorderBrush}" BorderThickness="1"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Effect" Value="{StaticResource LwGlowHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LwGhostPressedFillBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Section card list (mixed mode): no inner scroller — the sections scroll
             together in the outer ScrollViewer; every row stays in the UIA tree. -->
        <ControlTemplate x:Key="PlainList" TargetType="ListBox">
            <ItemsPresenter />
        </ControlTemplate>
        <!-- Labelled sort-direction toggle (P10): text adapts to the sort field.
             P10 M5: r full, matching LwIconToggle and the segmented control. -->
        <Style TargetType="ToggleButton" x:Key="OrderToggle">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource LwText1Brush}" />
            <Setter Property="FontFamily" Value="{StaticResource LwFontUi}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chrome" Background="{StaticResource LwStorm2Brush}"
                                BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LwFocusBorderSoftBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Deliberate two-row filter band (P3), closed by a hairline like the library header. -->
        <Border Grid.Row="0" BorderBrush="{StaticResource LwHairlineBrush}" BorderThickness="0,0,0,1"
                Padding="40,10,40,14" Background="Transparent" PreviewMouseWheel="OnFilterWheel">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Row A: [seed chip] · SEARCH · TYPE · [More filters]
                     P10 M11: GENRE, WATCHED and YEAR moved behind the disclosure below.
                     Measured at the 700x480 window minimum, this row used to clip GENRE at
                     the window edge and push WATCHED off-screen entirely, with nothing to
                     scroll - the facets were simply unreachable.

                     2026-08-05: a WrapPanel, not the 4-column Grid it was. The Grid could not
                     reflow, so as soon as the seed chip appeared it pushed the last column out:
                     MEASURED at 700x480 DIP, "More filters" sat at x=1187..1356 against a window
                     ending at 1250 - two thirds of it off-screen, and with it the ONLY route to
                     GENRE, WATCHED, YEAR and (since today) PERSON. Applying a person therefore
                     locked you out of changing it. Same fix, and the same reason, as LibraryView's
                     header: wrap onto another row rather than clip. SEARCH takes a fixed 300 (it
                     was * between 234 and 314) because a WrapPanel has no star sizing; the widest
                     case loses 14 px and the narrow case gains a route back. -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal">
                    <!-- Deep-link context chip (M5 person / M6 genre) — the seed is visible
                         and removable instead of an invisible filter. -->
                    <StackPanel x:Name="SeedFacet" Margin="0,0,14,8" Visibility="Collapsed">
                        <TextBlock x:Name="SeedCaption" Text="PERSON" Style="{StaticResource FacetCaption}" />
                        <!-- P10 M5: height-bound radius (h38 -> 19) — a person/genre name makes
                             this chip far wider than tall, so LwRPill drew a lens. -->
                        <Border Height="38"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                                Background="{StaticResource LwGarnetChipFillBrush}"
                                BorderBrush="{StaticResource LwGarnetChipBorderBrush}" BorderThickness="1"
                                Padding="14,0,4,0" SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="SeedChipText" VerticalAlignment="Center"
                                           FontFamily="{StaticResource LwFontUi}" FontSize="13.5"
                                           Foreground="#EEB9C4" MaxWidth="180" TextTrimming="CharacterEllipsis"
                                           AutomationProperties.AutomationId="AsSeedChip" />
                                <Button x:Name="SeedChipRemove" Width="22" Height="22" Margin="6,0,4,0"
                                        VerticalAlignment="Center" Cursor="Hand" Padding="0"
                                        FontFamily="{StaticResource LwFontIcon}" FontSize="14"
                                        Foreground="#EEB9C4" Content="{StaticResource IconClose}"
                                        Click="OnSeedRemoved" ToolTip="Remove this filter"
                                        AutomationProperties.AutomationId="AsSeedChipRemove">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <!-- 22x22 square: LwRPill already clamps to a
                                                 perfect circle here, so it stays a token. -->
                                            <Border x:Name="Chrome" Background="Transparent" CornerRadius="{StaticResource LwRPill}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="Background" Value="#40D14560" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Free text: the single search input on this screen (P5). -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="SEARCH" Style="{StaticResource FacetCaption}" />
                        <Grid Height="38" Width="300">
                            <TextBox x:Name="SearchBox" Style="{StaticResource LwTextField}"
                                     KeyDown="OnSearchKeyDown" TextChanged="OnSearchTextChanged"
                                     AutomationProperties.AutomationId="AsSearchBox" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Title, keyword…" IsHitTestVisible="False"
                                       Foreground="{StaticResource LwText3Brush}" FontSize="14"
                                       VerticalAlignment="Center" Margin="15,0,0,0" />
                            <Border x:Name="SearchEngaged" Style="{StaticResource EngagedRing}" />
                        </Grid>
                    </StackPanel>

                    <!-- Item type (multi) -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="TYPE" Style="{StaticResource FacetCaption}" />
                        <Grid>
                            <local:CheckDropdown x:Name="TypeFilter" Width="170" Height="38"
                                                 AutomationProperties.AutomationId="AsTypeFilter" />
                            <Border x:Name="TypeEngaged" Style="{StaticResource EngagedRing}" />
                        </Grid>
                    </StackPanel>

                    <!-- The disclosure. The count badge is not decoration: a filter behind a
                         collapsed panel could otherwise narrow the results with nothing on
                         screen to say so. -->
                    <StackPanel VerticalAlignment="Bottom" Margin="0,0,0,8">
                        <TextBlock Text=" " Style="{StaticResource FacetCaption}" />
                        <ToggleButton x:Name="MoreFiltersButton" Style="{StaticResource OrderToggle}"
                                      Checked="OnMoreFiltersToggled" Unchecked="OnMoreFiltersToggled"
                                      ToolTip="Genre, watched state and year"
                                      AutomationProperties.AutomationId="AsMoreFiltersButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="MoreFiltersGlyph" FontFamily="{StaticResource LwFontIcon}"
                                           FontSize="17" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Text="{StaticResource IconExpandMore}" />
                                <TextBlock Text="More filters" VerticalAlignment="Center" />
                                <Border x:Name="MoreFiltersBadge" Visibility="Collapsed"
                                        Margin="8,0,0,0" Height="20" MinWidth="20" Padding="6,0"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource LwGarnetChipFillBrush}"
                                        BorderBrush="{StaticResource LwGarnetChipBorderBrush}" BorderThickness="1"
                                        CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}">
                                    <TextBlock x:Name="MoreFiltersCount" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" FontSize="11.5"
                                               FontFamily="{StaticResource LwFontUi}" Foreground="#EEB9C4"
                                               AutomationProperties.AutomationId="AsMoreFiltersCount" />
                                </Border>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </WrapPanel>

                <!-- Row C: the disclosed filters. Collapsed until More filters is pressed;
                     a WrapPanel so it also survives the window minimum on its own row. -->
                <WrapPanel x:Name="MoreFiltersPanel" Grid.Row="2" Margin="0,12,0,0"
                           Visibility="Collapsed" Orientation="Horizontal"
                           AutomationProperties.AutomationId="AsMoreFiltersPanel">
                    <!-- Person (single, type-ahead — 2026-08-05). Before this the person filter
                         existed but could ONLY be set by clicking a cast face on a detail view,
                         so it was a filter nobody could type. It lives behind the disclosure
                         rather than in Row A because Row A was deliberately stripped to
                         chip/search/type/disclosure to survive 700x480 (see the comment above
                         Row A); the disclosure IS the "move it, never drop it" answer. The
                         APPLIED person still shows in Row A as the garnet seed chip, so the
                         filter is never invisible while the panel is shut. -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="PERSON" Style="{StaticResource FacetCaption}" />
                        <Grid Height="38">
                            <TextBox x:Name="PersonBox" Style="{StaticResource LwTextField}" Width="200"
                                     ToolTip="Filter by an actor or director"
                                     TextChanged="OnPersonTextChanged"
                                     PreviewKeyDown="OnPersonKeyDown"
                                     LostKeyboardFocus="OnPersonLostFocus"
                                     AutomationProperties.AutomationId="AsPersonBox" />
                            <TextBlock x:Name="PersonPlaceholder" Text="Actor, director…" IsHitTestVisible="False"
                                       Foreground="{StaticResource LwText3Brush}" FontSize="13.5"
                                       VerticalAlignment="Center" Margin="13,0,0,0" />
                            <Border x:Name="PersonEngaged" Style="{StaticResource EngagedRing}" />
                        </Grid>
                        <!-- StaysOpen=True deliberately, unlike CheckDropdown's popup: a
                             StaysOpen=False popup takes mouse capture, and the first click back
                             into the box you are typing in would be spent closing the popup
                             instead of placing the caret. Closing is driven from code instead
                             (Esc, commit, focus loss, term under 2 chars). -->
                        <Popup x:Name="PersonPopup" AllowsTransparency="True" Placement="Bottom"
                               StaysOpen="True" PopupAnimation="Fade" VerticalOffset="4"
                               PlacementTarget="{Binding ElementName=PersonBox}">
                            <Border Background="{StaticResource LwStorm3Brush}"
                                    BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource LwR2}" Padding="5"
                                    MinWidth="{Binding ActualWidth, ElementName=PersonBox}"
                                    Effect="{StaticResource LwElevation2}" SnapsToDevicePixels="True"
                                    TextElement.FontFamily="{StaticResource LwFontUi}">
                                <StackPanel>
                                    <!-- Non-empty Text is load-bearing: WPF prunes an empty
                                         TextBlock from the UIA tree, so a suite could never see
                                         it. It is collapsed when there is nothing to say. -->
                                    <TextBlock x:Name="PersonSuggestStatus" Text="No people found"
                                               Visibility="Collapsed" Margin="8,5"
                                               Foreground="{StaticResource LwText3Brush}" FontSize="13.5"
                                               AutomationProperties.AutomationId="AsPersonSuggestStatus" />
                                    <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                                        <ListBox x:Name="PersonSuggestList"
                                                 Background="Transparent" BorderThickness="0"
                                                 ItemContainerStyle="{StaticResource LwSuggestItem}"
                                                 SelectionChanged="OnPersonSuggestionPicked"
                                                 AutomationProperties.AutomationId="AsPersonSuggestList" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>

                    <!-- Genre (multi) -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="GENRE" Style="{StaticResource FacetCaption}" />
                        <Grid Height="38">
                            <local:CheckDropdown x:Name="GenreFilter" Width="200" Height="38"
                                                 AutomationProperties.AutomationId="AsGenreFilter" />
                            <Border x:Name="GenreEngaged" Style="{StaticResource EngagedRing}" />
                        </Grid>
                    </StackPanel>

                    <!-- Watched state: the shipped M22 segmented control (all options visible). -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="WATCHED" Style="{StaticResource FacetCaption}" />
                        <Grid VerticalAlignment="Bottom">
                            <!-- SelectionChanged wired in code-behind: the runtime XAML event
                                 converter for custom element types needs exact delegate
                                 signatures (M22 foot-gun). -->
                            <local:LwSegmentedControl x:Name="WatchedFilter" Style="{StaticResource LwSegmented}"
                                                      VerticalAlignment="Center"
                                                      AutomationProperties.AutomationId="AsWatchedFilter" />
                            <Border x:Name="WatchedEngaged" Style="{StaticResource EngagedRing}" />
                        </Grid>
                    </StackPanel>

                    <!-- Year range (P4): From / To placeholders, clear affordance. -->
                    <StackPanel Margin="0,0,14,8">
                        <TextBlock Text="YEAR" Style="{StaticResource FacetCaption}" />
                        <StackPanel Orientation="Horizontal" Height="38">
                            <Grid>
                                <TextBox x:Name="MinYearBox" Style="{StaticResource LwTextField}" Width="74"
                                         MaxLength="4" ToolTip="From year"
                                         KeyDown="OnYearKeyDown" LostFocus="OnYearCommitted"
                                         TextChanged="OnYearTextChanged"
                                         AutomationProperties.AutomationId="AsMinYear" />
                                <TextBlock x:Name="MinYearPlaceholder" Text="From" IsHitTestVisible="False"
                                           Foreground="{StaticResource LwText3Brush}" FontSize="13.5"
                                           VerticalAlignment="Center" Margin="13,0,0,0" />
                                <Border x:Name="MinYearEngaged" Style="{StaticResource EngagedRing}" />
                            </Grid>
                            <TextBlock Text="–" VerticalAlignment="Center" Margin="6,0"
                                       Foreground="{StaticResource LwText3Brush}" />
                            <Grid>
                                <TextBox x:Name="MaxYearBox" Style="{StaticResource LwTextField}" Width="74"
                                         MaxLength="4" ToolTip="To year"
                                         KeyDown="OnYearKeyDown" LostFocus="OnYearCommitted"
                                         TextChanged="OnYearTextChanged"
                                         AutomationProperties.AutomationId="AsMaxYear" />
                                <TextBlock x:Name="MaxYearPlaceholder" Text="To" IsHitTestVisible="False"
                                           Foreground="{StaticResource LwText3Brush}" FontSize="13.5"
                                           VerticalAlignment="Center" Margin="13,0,0,0" />
                                <Border x:Name="MaxYearEngaged" Style="{StaticResource EngagedRing}" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </WrapPanel>

                <!-- Row B: SORT · ORDER · … · result summary (right-docked, P8).
                     YEAR left this row for the More-filters disclosure (P10 M11): sort and
                     order are not filters, so they stay permanently visible. -->
                <DockPanel Grid.Row="1" Margin="0,12,0,0" LastChildFill="False">
                    <!-- Sort field -->
                    <StackPanel DockPanel.Dock="Left" Margin="0,0,14,0">
                        <TextBlock Text="SORT" Style="{StaticResource FacetCaption}" />
                        <ComboBox x:Name="SortBox" Style="{StaticResource LwDropdown}" Width="170" Height="38"
                                  SelectionChanged="OnQueryChanged"
                                  AutomationProperties.AutomationId="AsSortBox" />
                    </StackPanel>

                    <!-- Sort direction (P10): labelled toggle, text follows the sort field;
                         hidden for Random (direction is meaningless there). -->
                    <StackPanel x:Name="OrderFacet" DockPanel.Dock="Left">
                        <TextBlock Text="ORDER" Style="{StaticResource FacetCaption}" />
                        <ToggleButton x:Name="OrderButton" Style="{StaticResource OrderToggle}"
                                      Checked="OnQueryChanged" Unchecked="OnQueryChanged"
                                      ToolTip="Sort direction"
                                      AutomationProperties.AutomationId="AsOrderButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="OrderGlyph" FontFamily="{StaticResource LwFontIcon}"
                                           FontSize="17" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Text="{StaticResource IconSortAsc}" />
                                <TextBlock x:Name="OrderLabel" Text="A–Z" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="AsOrderLabel" />
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>

                    <!-- Result summary (P8), mono, baseline with the controls. -->
                    <TextBlock x:Name="ResultSummary" DockPanel.Dock="Right"
                               Style="{StaticResource LwTypeMono}" FontSize="12.5"
                               Foreground="{StaticResource LwText3Brush}"
                               VerticalAlignment="Bottom" Margin="14,0,0,10"
                               AutomationProperties.AutomationId="AsResultSummary" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Results: single-type infinite grid (today's behavior)… -->
        <ListBox x:Name="ItemsGrid" Grid.Row="1"
                 Background="Transparent" BorderThickness="0"
                 ItemTemplateSelector="{StaticResource MediaCardSelector}"
                 ItemContainerStyle="{StaticResource LwMediaGridItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 SelectionChanged="OnSelection"
                 Padding="32,0,32,32"
                 AutomationProperties.AutomationId="AsResultsGrid">
            <!-- Inset moved from Padding onto the panel's Margin so the card hover scale is not
                 clipped by the ScrollViewer; the two cancel exactly (32+8 / 0+6 / 32+8 / 32+8 =
                 the original 40,6,40,40). The top is 6 rather than 8 because this surface started
                 from an asymmetric padding: a flat Margin="8" here would have pushed the first row
                 down 2 px, which the first version of this fix did while claiming to cancel. 6 px
                 still clears the largest vertical overhang (4.51 DIP). See LibraryView for the
                 measurement. -->
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" Margin="8,6,8,8" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

        <!-- …or type-grouped sections when more than one type is in play (P1). -->
        <ScrollViewer x:Name="SectionsScroll" Grid.Row="1" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="AsSections">
            <StackPanel x:Name="SectionsHost" Margin="40,6,40,40" />
        </ScrollViewer>

        <!-- Loading skeleton (M25), shown only when a query takes noticeable time. -->
        <ContentControl x:Name="SkeletonHost" Grid.Row="1" Margin="40,20,40,0"
                        VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />

        <TextBlock x:Name="StatusText" Grid.Row="1" Text=""
                   Style="{StaticResource LwTypeBody}" Foreground="{StaticResource LwText3Brush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                   AutomationProperties.AutomationId="AsStatus" />

        <!-- Center host: prompt state (P7) and zero-results share the EmptyState component;
             the chips / clear-filters affordances swap beneath it. -->
        <StackPanel x:Name="CenterHost" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <local:EmptyState x:Name="EmptyView" />
            <StackPanel x:Name="StarterChips" Orientation="Horizontal" HorizontalAlignment="Center"
                        Margin="0,18,0,0" Visibility="Collapsed">
                <Button Style="{StaticResource StarterChip}" Content="Browse movies"
                        Click="OnStarterMovies" AutomationProperties.AutomationId="AsStarterMovies" />
                <Button Style="{StaticResource StarterChip}" Content="Browse series"
                        Click="OnStarterSeries" AutomationProperties.AutomationId="AsStarterSeries" />
                <Button Style="{StaticResource StarterChip}" Content="Browse episodes"
                        Click="OnStarterEpisodes" AutomationProperties.AutomationId="AsStarterEpisodes" />
            </StackPanel>
            <Button x:Name="ClearFiltersBtn" Style="{StaticResource LwLinkButton}" FontSize="13"
                    Content="Clear all filters" HorizontalAlignment="Center" Margin="0,14,0,0"
                    Visibility="Collapsed" Click="OnClearAllFilters"
                    AutomationProperties.AutomationId="AsClearFilters" />
        </StackPanel>

        <!-- "Loading more" pill for the infinite-scroll append (2026-08-02). Single-type
             grid only - the mixed/type-grouped mode does not page. -->
        <local:LoadMoreIndicator x:Name="MoreLoading" Grid.Row="1" />
    </Grid>
</UserControl>
