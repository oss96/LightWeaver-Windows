<UserControl x:Class="LightWeaver.Views.OpenStreamView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LightWeaver.Localization"
        Foreground="{StaticResource LwText1Brush}" FontFamily="{StaticResource LwFontUi}"
        AutomationProperties.AutomationId="OpenStreamView">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Border Style="{StaticResource LwModalCard}" Margin="40,24,28,28" Effect="{x:Null}"
            MaxWidth="680" HorizontalAlignment="Left" VerticalAlignment="Top">
        <StackPanel>
            <TextBlock Text="{loc:Text OpenStreamView.PasteAVideoLink.762bb6a0}" FontFamily="{StaticResource LwFontDisplay}" FontSize="24" />
            <TextBlock Text="{loc:Text OpenStreamView.PlayADirectVideoOrLiveStream.73336491}"
                       TextWrapping="Wrap" Margin="0,10,0,24" Foreground="{StaticResource LwText2Brush}" />
            <TextBlock Text="{loc:Text OpenStreamView.VideoUrl.b9f5332d}" Margin="0,0,0,8" />
            <TextBox x:Name="StreamUrlBox" Style="{StaticResource LwTextField}" TextChanged="OnAddressChanged"
                     MinWidth="220" KeyDown="OnAddressKeyDown" HorizontalAlignment="Stretch"
                     AutomationProperties.AutomationId="StreamUrlBox" />
            <TextBlock Text="{loc:Text OpenStreamView.UseAFullHttpOrHttpsLink.163b1c5c}"
                       TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource LwText2Brush}" />
            <TextBlock x:Name="StreamUrlError" TextWrapping="Wrap" Margin="0,8,0,0"
                       Foreground="{StaticResource LwText2Brush}" Visibility="Collapsed"
                       AutomationProperties.AutomationId="StreamUrlError" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{loc:Text OpenStreamView.Play.67cefb55}" Style="{StaticResource LwButtonPrimary}" Margin="10,0,0,0"
                        MinWidth="88" Click="OnPlay"
                        AutomationProperties.AutomationId="StreamPlayButton" />
            </StackPanel>
            <TextBlock Text="{loc:Text OpenStreamView.NoLinkHistoryIsSavedBufferingUses.82f790bb}"
                       TextWrapping="Wrap" Margin="0,24,0,0" Foreground="{StaticResource LwText2Brush}" />
        </StackPanel>
    </Border>
    </ScrollViewer>
</UserControl>
