<UserControl x:Class="LightWeaver.Views.UpNextLeadPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:LightWeaver.Localization"
             xmlns:views="clr-namespace:LightWeaver.Views">
    <!-- One picker for the Settings row (no Global segment) and the show flyout on series, season
         and episode pages (with it), so the two cannot drift. Segment labels are bound in code. -->
    <StackPanel>
        <views:LwSegmentedControl x:Name="Segments" Style="{StaticResource LwSegmented}"
                                  HorizontalAlignment="Left"
                                  AutomationProperties.AutomationId="UpNextLeadSegments"
                                  AutomationProperties.Name="{loc:Text UpNextLeadPicker.Name}">
            <!-- The preset segments are inserted between these two from UpNextPreferences.LeadPresets. -->
            <ListBoxItem x:Name="GlobalSegment" AutomationProperties.AutomationId="UpNextLeadGlobal" />
            <ListBoxItem x:Name="CustomSegment" AutomationProperties.AutomationId="UpNextLeadCustom" />
        </views:LwSegmentedControl>
        <StackPanel x:Name="CustomPanel" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
            <TextBox x:Name="CustomBox" Style="{StaticResource LwTextField}" Width="80" Height="34"
                     TextChanged="OnCustomChanged"
                     AutomationProperties.AutomationId="UpNextLeadCustomBox"
                     AutomationProperties.Name="{loc:Text UpNextLeadPicker.CustomField}" />
            <TextBlock Text="{loc:Text UpNextLeadPicker.Seconds}" FontFamily="{StaticResource LwFontUi}"
                       Foreground="{StaticResource LwText2Brush}" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock x:Name="ErrorText" FontFamily="{StaticResource LwFontUi}" FontSize="12.5"
                   Foreground="{StaticResource LwGemAmberTextBrush}" TextWrapping="Wrap"
                   Margin="2,6,2,0" Visibility="Collapsed"
                   AutomationProperties.AutomationId="UpNextLeadError" />
    </StackPanel>
</UserControl>
