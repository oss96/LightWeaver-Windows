<UserControl x:Class="LightWeaver.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- S2 Home: horizontal rails that fade into the dark on the right edge (no arrows
         until hover). Section headers are Marcellus 24. Rails left-align at 40 px with the
         header search pill; the fade overlay is pinned right while rails scroll under it. -->
    <Grid>
        <!-- The 40 px left inset lives on the CONTENT's margin, not on the ScrollViewer's Padding,
             and that is a fix rather than a preference. A ScrollViewer clips at its content
             presenter, which Padding insets - so with Padding="40,…" the clip edge sat exactly
             where the first card starts, and the hover scale on LwMediaCardItem (1.03 about the
             card's centre, ~4.6 DIP per side on a 308-DIP landscape card) was cut off: a hovered
             leftmost card lost the first glyph of its title ("A Real Hero" rendered as "\ Real Hero"),
             thumbnail sliced too. As a Margin on the content the inset looks identical and the clip
             sits 40 px further out, which is far more than the overhang needs. The rail's own
             ScrollViewer needed the same treatment (MediaRowListBox) - BOTH clips cut, so fixing
             either alone changed nothing on screen. -->
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,6,0,28">
                <TextBlock x:Name="LoadingText" Text="Loading…" Foreground="{StaticResource LwText3Brush}"
                           Margin="0,12" Visibility="Collapsed" AutomationProperties.AutomationId="HomeLoading" />
                <!-- M25: shimmering rail skeletons while the first fold loads -->
                <StackPanel x:Name="SkeletonHost" />

                <!-- Section order is layout-driven (M11): ApplyLayout reorders these
                     children per the profile's saved HomeLayoutStore preference. -->
                <StackPanel x:Name="SectionsHost">
                    <!-- Section headers are see-all links (Phase 7): click opens the full
                         paged listing. Libraries keeps a plain header — the rail IS the
                         complete list, there is nothing more to see. -->
                    <StackPanel x:Name="ResumeSection" Visibility="Collapsed">
                        <Button Content="Continue Watching" Style="{StaticResource LwSectionHeaderLink}"
                                Margin="0,26,0,14" Click="OnSeeAll" Tag="Resume"
                                ToolTip="See all" AutomationProperties.AutomationId="SeeAllResume" />
                        <ListBox x:Name="ResumeRow" Style="{StaticResource MediaRowListBox}"
                                 SelectionChanged="OnRowSelection"
                                 AutomationProperties.AutomationId="ResumeRow" />
                    </StackPanel>

                    <StackPanel x:Name="NextUpSection" Visibility="Collapsed">
                        <Button Content="Next Up" Style="{StaticResource LwSectionHeaderLink}"
                                Margin="0,30,0,14" Click="OnSeeAll" Tag="NextUp"
                                ToolTip="See all" AutomationProperties.AutomationId="SeeAllNextUp" />
                        <ListBox x:Name="NextUpRow" Style="{StaticResource MediaRowListBox}"
                                 SelectionChanged="OnRowSelection"
                                 AutomationProperties.AutomationId="NextUpRow" />
                    </StackPanel>

                    <StackPanel x:Name="LatestSection" Visibility="Collapsed">
                        <Button Content="Recently Added" Style="{StaticResource LwSectionHeaderLink}"
                                Margin="0,30,0,14" Click="OnSeeAll" Tag="Latest"
                                ToolTip="See all" AutomationProperties.AutomationId="SeeAllLatest" />
                        <ListBox x:Name="LatestRow" Style="{StaticResource MediaRowListBox}"
                                 SelectionChanged="OnRowSelection"
                                 AutomationProperties.AutomationId="LatestRow" />
                    </StackPanel>

                    <StackPanel x:Name="FavoritesSection" Visibility="Collapsed">
                        <Button Content="Favorites" Style="{StaticResource LwSectionHeaderLink}"
                                Margin="0,30,0,14" Click="OnSeeAll" Tag="Favorites"
                                ToolTip="See all" AutomationProperties.AutomationId="SeeAllFavorites" />
                        <ListBox x:Name="FavoritesRow" Style="{StaticResource MediaRowListBox}"
                                 SelectionChanged="OnRowSelection"
                                 AutomationProperties.AutomationId="FavoritesRow" />
                    </StackPanel>

                    <StackPanel x:Name="LibrariesSection" Visibility="Collapsed">
                        <TextBlock Text="Libraries" Style="{StaticResource LwTypeTitle}" Margin="0,30,0,14" />
                        <ListBox x:Name="LibrariesRow" Style="{StaticResource MediaRowListBox}"
                                 SelectionChanged="OnRowSelection"
                                 AutomationProperties.AutomationId="LibrariesRow" />
                    </StackPanel>
                </StackPanel>

                <TextBlock x:Name="ErrorText" Foreground="{StaticResource LwEmberHoverTextBrush}"
                           Visibility="Collapsed" Margin="0,12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="HomeError" />
            </StackPanel>
        </ScrollViewer>

        <!-- Customize (M11): reorder/toggle the rails; per-profile persistence. Sits at
             the page's top-right, clear of the right-edge fade. Home-only by design — it is
             the section customizer, not a library filter (Phase 8 M4.5); the tooltip names
             "sections" so it can't be mistaken for a missing-elsewhere filter entry point. -->
        <Button x:Name="CustomizeButton" Style="{StaticResource LwCardActionButton}"
                Width="34" Height="34" FontSize="17"
                Content="{StaticResource IconTune}" ToolTip="Customize home sections"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,24,0"
                Click="OnCustomize" Focusable="True"
                AutomationProperties.AutomationId="HomeCustomizeButton" />

        <!-- Right edge fade: rails dissolve into storm-0, no hard cut -->
        <Rectangle Width="90" HorizontalAlignment="Right" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#000C0E16" Offset="0" />
                    <GradientStop Color="{StaticResource LwStorm1Color}" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
