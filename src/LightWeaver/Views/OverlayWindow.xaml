<Window x:Class="LightWeaver.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LightWeaver.ViewModels"
        xmlns:img="clr-namespace:LightWeaver.Imaging"
        xmlns:theme="clr-namespace:LightWeaver.Theme"
        xmlns:views="clr-namespace:LightWeaver.Views"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:PlayerViewModel}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize">
    <!-- S5 Player OSD: floats over the live mpv HWND. Low total luminance — scrims are
         storm-0 gradients (<= 0.92 a at the very edge), glyphs <= text-1, glow accents soft,
         so nothing blooms over HDR video. Near-invisible root so the overlay gets ALL mouse
         input over the video HWND (alpha must stay well above 1 or Windows clicks through). -->
    <Grid Background="#0C000000" AllowDrop="True"
          MouseMove="OnRootMouseMove" Drop="OnRootDrop"
          MouseLeftButtonDown="OnRootMouseDown"
          MouseWheel="OnRootMouseWheel">

        <!-- Top scrim (behind back / title / gem pills) -->
        <Border x:Name="TopScrim" VerticalAlignment="Top" Height="150" IsHitTestVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#C707080D" Offset="0" />
                    <GradientStop Color="#0007080D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <Button x:Name="BackButton" Style="{StaticResource LwOsdButton}"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="28,24,0,0" Width="38" Height="38" FontSize="17"
                Content="{StaticResource IconBack}" Click="OnBackClick" ToolTip="Back to browsing"
                AutomationProperties.AutomationId="BackButton" />
        <StackPanel x:Name="TitlePanel"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="80,26,320,0">
            <TextBlock Text="{Binding NowPlayingTitle}"
                       AutomationProperties.AutomationId="NowPlayingTitle"
                       FontFamily="{StaticResource LwFontUi}" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource LwText1Brush}" TextTrimming="CharacterEllipsis">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF07080D" ShadowDepth="1" BlurRadius="8" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{Binding NowPlayingSubtitle}"
                       AutomationProperties.AutomationId="NowPlayingSubtitle"
                       FontFamily="{StaticResource LwFontUi}" FontSize="13"
                       Foreground="{StaticResource LwText2Brush}" Margin="0,2,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="{Binding HasNowPlayingSubtitle, Converter={StaticResource BoolToVisibleConverter}}">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF07080D" ShadowDepth="1" BlurRadius="8" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
            <!-- Playback status badges: passive blue-gem info pills, each shown only while
                 active. Phase 8 M7.1: RTX state (HDR + VSR) is shown ONLY by the garnet gem
                 toggles (top-right) now — these pills keep just what the toggles can't say:
                 native-source HDR and the source resolution. Inside TitlePanel so they ride
                 the idle fade and disappear in mini mode with the rest of the top chrome. -->
            <StackPanel x:Name="StatusBadgePanel" Orientation="Horizontal" Margin="0,8,0,0">
                <Label Style="{StaticResource LwOsdStatusPillBlue}"
                       Content="{Binding StatusHdrLabel}"
                       AutomationProperties.Name="{Binding StatusHdrLabel}"
                       Visibility="{Binding HasStatusHdr, Converter={StaticResource BoolToVisibleConverter}}"
                       Margin="0,0,6,0"
                       AutomationProperties.AutomationId="BadgeHdr" />
                <Label Style="{StaticResource LwOsdStatusPillBlue}"
                       Content="{Binding StatusResolutionLabel}"
                       AutomationProperties.Name="{Binding StatusResolutionLabel}"
                       Visibility="{Binding HasStatusResolution, Converter={StaticResource BoolToVisibleConverter}}"
                       Margin="0,0,6,0"
                       AutomationProperties.AutomationId="BadgeResolution" />
                <!-- Release / first-air date (2026-08-05). A badge rather than more text in the
                     subtitle line: for an episode that line is already "S1E1 · Episode name" and
                     is width-constrained with CharacterEllipsis, so a date appended there would
                     push the episode name out. Riding this panel also means it inherits the idle
                     fade and the mini-mode collapse for free. Hidden when the server has no
                     premiere date. -->
                <Label Style="{StaticResource LwOsdStatusPillBlue}"
                       Content="{Binding NowPlayingRelease}"
                       AutomationProperties.Name="{Binding NowPlayingRelease}"
                       Visibility="{Binding HasNowPlayingRelease, Converter={StaticResource BoolToVisibleConverter}}"
                       AutomationProperties.AutomationId="BadgeRelease" />
            </StackPanel>
        </StackPanel>

        <!-- Feature gem pills (top-right): RTX toggles, garnet when active.
             Phase 9 M4: HIDDEN rather than disabled when RTX video processing can't apply -
             unsupported GPU/driver, or a PQ/HLG source (NVIDIA's video processing is SDR-only,
             so the chain is gamma-suppressed). An inert control that can never be used is
             clutter; RtxAvailable already merges both causes and raises change notifications,
             and IsChecked stays the user's stored preference, so this hides without unchecking.
             The per-cause tooltips remain for the visible state; ToolTipService.ShowOnDisabled
             is gone with the disabled state it existed for. -->
        <StackPanel x:Name="GemPillPanel" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,36,0">
            <ToggleButton Content="RTX HDR" Style="{StaticResource LwOsdGemToggle}"
                          IsChecked="{Binding RtxHdrEnabled}"
                          Visibility="{Binding RtxAvailable, Converter={StaticResource BoolToVisibleConverter}}"
                          ToolTip="{Binding RtxHdrTooltip}"
                          Margin="0,0,8,0"
                          AutomationProperties.AutomationId="RtxHdrToggle" />
            <ToggleButton Content="RTX VSR" Style="{StaticResource LwOsdGemToggle}"
                          IsChecked="{Binding RtxVsrEnabled}"
                          Visibility="{Binding RtxAvailable, Converter={StaticResource BoolToVisibleConverter}}"
                          ToolTip="{Binding RtxVsrTooltip}"
                          AutomationProperties.AutomationId="RtxVsrToggle" />
        </StackPanel>

        <!-- Volume indicator (P10 M10). Transient readout on a volume or mute change, with
             its own hold-then-fade lifecycle: it is NOT part of the idle-fade group
             (ControlsPanel/TopScrim/TitlePanel/BackButton/GemPillPanel), so a volume nudge
             no longer wakes the whole bottom bar and the bar's idle timer cannot take this
             pill away early. Both halves of "independent of the full OSD".

             The offset is FIXED rather than stacked under GemPillPanel: those toggles are
             hidden on a non-RTX GPU and on PQ/HLG sources (Phase 9 M4), so a stacked pill
             would sit in a different place depending on the GPU and the source. 64 clears
             the gem row (top 28 + height 24) with a 12 px gap; the right edge is theirs.

             Starts Collapsed, not merely Opacity=0: an Opacity-0 element is still a live
             UIA element, and "the pill is present" is the signal the suites read. -->
        <Border x:Name="VolumePill"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,64,36,0" Height="34" Padding="14,0"
                Background="{StaticResource LwStorm3Brush}"
                BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                Effect="{StaticResource LwElevation2}"
                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The glyph is the mute state (the text is always the level). ItemStatus is
                     how a glyph exposes its state to UIA here — the same signal MuteButton
                     carries, because a Material codepoint is not a readable string. -->
                <TextBlock x:Name="VolumePillGlyph" Text="{StaticResource IconVolume}"
                           FontFamily="{StaticResource LwFontIcon}" FontSize="17"
                           Foreground="{StaticResource LwText2Brush}" VerticalAlignment="Center"
                           AutomationProperties.ItemStatus="{Binding IsMuted}"
                           AutomationProperties.AutomationId="VolumeIndicatorGlyph" />
                <!-- MinWidth holds the pill steady across 5% -> 100% -> "Muted" so the
                     chrome does not jitter while a key is held down. -->
                <TextBlock x:Name="VolumePillText" Margin="9,0,0,0" MinWidth="46"
                           TextAlignment="Right"
                           FontFamily="{StaticResource LwFontMono}" FontSize="13.5"
                           Foreground="{StaticResource LwText1Brush}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="VolumeIndicator" />
            </StackPanel>
        </Border>

        <Button x:Name="SkipSegmentButton" Style="{StaticResource LwButtonSecondary}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,40,150" Height="40" Padding="18,0" FontSize="14"
                Content="{Binding SkipButtonLabel}"
                Visibility="{Binding SkipButtonVisible, Converter={StaticResource BoolToVisibleConverter}}"
                Click="OnSkipSegment"
                AutomationProperties.AutomationId="SkipSegmentButton" />
        <!-- Up Next card: appears at credits start / last 30 s of an episode.
             P10 M6: 10 -> LwR4 (28), closing the last leg of the "10 in three places by
             coincidence" trap (LwOsdButton and LwOsdPlayButton went in M5) and joining the
             modal-weight family with LwModalCard and the sign-in card. The thumb inside is
             LwR1 (8) with a real round clip — ClipToBounds does not follow CornerRadius. -->
        <Border x:Name="UpNextCard"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Margin="0,0,40,210" Width="300"
                CornerRadius="{StaticResource LwR4}" Padding="12"
                Background="{StaticResource LwStorm3Brush}" BorderBrush="{StaticResource LwStrokeBrush}"
                BorderThickness="1" Effect="{StaticResource LwElevation2}"
                Cursor="Hand"
                MouseLeftButtonUp="OnUpNextCardClick"
                Visibility="{Binding UpNextVisible, Converter={StaticResource BoolToVisibleConverter}}">
            <StackPanel>
                <TextBlock Text="UP NEXT" Style="{StaticResource LwTypeLabel}" Margin="1,0,0,7" />
                <Border CornerRadius="{StaticResource LwR1}" Height="157" Background="{StaticResource LwStorm2Brush}">
                    <!-- Clip on the Grid, not the Image — an Image with UniformToFill reports the
                         stretched content size, not its slot, so a clip on it can trim nothing. -->
                    <Grid theme:RoundedClip.Radius="8">
                        <Image img:CachedImage.DecodeWidth="480"
                               img:CachedImage.SourceUrl="{Binding UpNextThumbUrl}"
                               Stretch="UniformToFill" />
                    </Grid>
                </Border>
                <TextBlock Text="{Binding UpNextTitle}" FontFamily="{StaticResource LwFontUi}"
                           FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource LwText1Brush}"
                           Margin="1,9,1,0" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="UpNextTitle" />
                <TextBlock Text="{Binding UpNextSubtitle}" FontFamily="{StaticResource LwFontUi}"
                           FontSize="12" Foreground="{StaticResource LwText3Brush}"
                           Margin="1,2,1,0" TextTrimming="CharacterEllipsis" />
                <DockPanel Margin="1,12,1,0" LastChildFill="False">
                    <!-- Hidden in manual mode ("Auto-play next episode" off): the card is an
                         offer, not a timer. UpNextCountdownText is "" there too, so the text
                         and the visibility can't disagree. -->
                    <TextBlock Text="{Binding UpNextCountdownText}" VerticalAlignment="Center"
                               Foreground="{StaticResource LwText2Brush}" FontSize="13"
                               FontFamily="{StaticResource LwFontUi}"
                               Visibility="{Binding UpNextHasCountdown, Converter={StaticResource BoolToVisibleConverter}}"
                               AutomationProperties.AutomationId="UpNextCountdown" />
                    <Button DockPanel.Dock="Right" Content="Play now" Style="{StaticResource LwButtonPrimary}"
                            Height="30" Padding="12,0" Click="OnUpNextPlay" Margin="8,0,0,0"
                            AutomationProperties.AutomationId="UpNextPlayButton" />
                    <Button DockPanel.Dock="Right" Content="Dismiss" Style="{StaticResource LwButtonGhost}"
                            Height="30" Padding="12,0" Click="OnUpNextDismiss"
                            AutomationProperties.AutomationId="UpNextDismissButton" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- M26 buffering indicator: shown while mpv reports paused-for-cache. Sits
             OUTSIDE the idle-fade group (ControlsPanel/TopScrim/TitlePanel/BackButton/
             GemPillPanel) so a stall stays visible while the controls are faded. Drawn
             in this transparent overlay window only — never composited into the mpv
             HWND (load-bearing rule). -->
        <!-- One indicator, two states: a stall mid-film and a load that has not produced a frame
             yet. The CAPTION is what tells them apart, and it is also the readable signal for the
             suites — the dots carry no text and no automation peer. Loading additionally hides the
             transport bar (see TransportVisible); a stall deliberately does not. -->
        <StackPanel IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasPlaybackStatus, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid HorizontalAlignment="Center">
                <!-- Larger than the browse default (5 px) because this one is read across a
                     room, but PeakOpacity is held at 0.55: this overlay composites over HDR
                     video and 0.55 is the glow budget that keeps it from blooming. The browse
                     pills sit on storm backgrounds and peak at 0.95. -->
                <views:ActivityDots DotSize="9" Gap="7" DimOpacity="0.22" PeakOpacity="0.55" />
                <!-- UIA marker: real (transparent) text so the peer survives control-view
                     pruning of empty elements (M25 foot-gun). Kept on this element, and kept
                     spelled "Buffering", because test-buffering.ps1 finds the indicator by
                     this id. -->
                <TextBlock Text="Buffering" Foreground="Transparent" FontSize="10"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="BufferingIndicator" />
            </Grid>
            <TextBlock Text="{Binding PlaybackStatusText}" Margin="0,14,0,0"
                       HorizontalAlignment="Center"
                       FontFamily="{StaticResource LwFontUi}" FontSize="13"
                       Foreground="{StaticResource LwText2Brush}"
                       AutomationProperties.AutomationId="PlaybackStatusText">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF07080D" ShadowDepth="1" BlurRadius="8" Opacity="0.9" />
                </TextBlock.Effect>
            </TextBlock>
        </StackPanel>

        <!-- Bottom scrim: seek bar + time + transport controls -->
        <!-- Hidden while loading: a bar parked at 0:00 with a live-looking pause glyph is exactly
             what made a slow load read as a broken player. Visibility (not opacity) so it is gone
             from the UIA tree too — "the controls are absent" is then a fact a suite can assert,
             not an appearance. SetMiniMode / UpdateCompactControls touch the children rather than
             this Border, so they compose with it. -->
        <Border x:Name="ControlsPanel" VerticalAlignment="Bottom" Padding="40,40,40,24"
                Visibility="{Binding TransportVisible, Converter={StaticResource BoolToVisibleConverter}}">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#0007080D" Offset="0" />
                    <GradientStop Color="#9907080D" Offset="0.45" />
                    <GradientStop Color="#EB07080D" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Slider x:Name="SeekSlider" Style="{StaticResource LwSlider}"
                            Minimum="0"
                            Maximum="{Binding DurationSeconds, Mode=OneWay}"
                            Value="{Binding PositionSeconds, Mode=TwoWay}"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"
                            PreviewMouseLeftButtonUp="OnSeekClick"
                            PreviewMouseMove="OnSeekSliderMouseMove"
                            MouseLeave="OnSeekSliderMouseLeave"
                            LostMouseCapture="OnSeekLostCapture" />
                    <Canvas x:Name="ChapterMarkerCanvas" IsHitTestVisible="False"
                            Height="10" VerticalAlignment="Center" SizeChanged="OnMarkerCanvasSize" />
                </Grid>

                <DockPanel Grid.Row="1" Margin="0,10,0,0" LastChildFill="False">
                    <!-- Click the time to type a position (2026-08-07). The resting element is
                         UNCHANGED on purpose: driver.ps1's Read-TimeDisplay finds the time by the
                         regex ^\d+:\d+ / \d+:\d+$ over Text descendants and several suites parse
                         what it returns, so this stays ONE TextBlock with ONE binding rather than
                         separate elapsed/total blocks.
                         The near-transparent Background IS load-bearing: a background-less
                         TextBlock hit-tests its GLYPH PIXELS only, so presses landing in the gaps
                         between digits would fall through to the video - the same trap
                         MiniResizeGrip below documents. Alpha 1 is invisible over the scrim. -->
                    <TextBlock x:Name="TimeText" DockPanel.Dock="Left"
                               Text="{Binding TimeDisplay}" VerticalAlignment="Center"
                               FontFamily="{StaticResource LwFontMono}" FontSize="12"
                               Foreground="{StaticResource LwText2Brush}"
                               Background="#01000000"
                               ToolTip="Click to type a position"
                               MouseLeftButtonUp="OnTimeTextClick"
                               MouseEnter="OnTimeTextMouseEnter"
                               MouseLeave="OnTimeTextMouseLeave" />
                    <!-- The inline editor, which REPLACES TimeText for the duration of an edit.
                         Collapsed at rest, not merely transparent: a collapsed element leaves the
                         UIA tree, so "the editor is open" is a fact a suite can assert (the same
                         reason VolumePill collapses).
                         h20 rather than LwTextField's h38, and mono at the label's own size: the
                         row is 16 px of text, and a 38 px field would visibly grow the bar the
                         moment the user clicked. Width is fixed so the row cannot reflow as digits
                         are typed. -->
                    <TextBox x:Name="TimeEditBox" DockPanel.Dock="Left"
                             Style="{StaticResource LwTextField}" Visibility="Collapsed"
                             Width="80" Height="20" Padding="8,0"
                             FontFamily="{StaticResource LwFontMono}" FontSize="12"
                             ToolTip="ss, mm:ss or hh:mm:ss - Enter seeks, Esc cancels"
                             LostKeyboardFocus="OnTimeEditLostFocus"
                             AutomationProperties.AutomationId="TimeEditBox" />
                </DockPanel>

                <DockPanel x:Name="ControlsRow" Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
                    <Button x:Name="PauseButton" DockPanel.Dock="Left"
                            Style="{StaticResource LwOsdPlayButton}"
                            Command="{Binding TogglePauseCommand}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{StaticResource IconPause}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Text" Value="{StaticResource IconPlay}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconJumpBack}"
                            Margin="6,0,0,0" Click="OnJumpBack"
                            ToolTip="Jump back (Left arrow)"
                            AutomationProperties.AutomationId="JumpBackButton" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconJumpForward}"
                            Margin="4,0,0,0" Click="OnJumpForward"
                            ToolTip="Jump forward (Right arrow)"
                            AutomationProperties.AutomationId="JumpForwardButton" />

                    <!-- ONE next/previous pair (P10). This replaces the old queue pair and the
                         separate episode pair, which sat side by side doing the same thing
                         whenever an episode played from a season queue. Precedence lives in the
                         view model: queue entry, then armed Up Next, then series order. The pair
                         no longer follows the M17 chapter/seek mapping - chapters have their own
                         buttons a few controls along, shown only when the file has any. -->
                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconPrev}"
                            Margin="6,0,0,0" Click="OnPrevious"
                            ToolTip="{Binding PreviousTooltip}"
                            Visibility="{Binding ShowNextPrevButtons, Converter={StaticResource BoolToVisibleConverter}}"
                            IsEnabled="{Binding CanGoPrevious}"
                            AutomationProperties.AutomationId="PrevButton" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconNext}"
                            Margin="4,0,0,0" Click="OnNext"
                            ToolTip="{Binding NextTooltip}"
                            Visibility="{Binding ShowNextPrevButtons, Converter={StaticResource BoolToVisibleConverter}}"
                            IsEnabled="{Binding CanGoNext}"
                            AutomationProperties.AutomationId="NextButton" />

                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconPrevChapter}"
                            Margin="6,0,0,0" Click="OnPrevChapter"
                            ToolTip="Previous chapter ([)"
                            Visibility="{Binding HasChapters, Converter={StaticResource BoolToVisibleConverter}}"
                            AutomationProperties.AutomationId="PrevChapterButton" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource LwOsdButton}" Content="{StaticResource IconNextChapter}"
                            Margin="4,0,0,0" Click="OnNextChapter"
                            ToolTip="Next chapter (])"
                            Visibility="{Binding HasChapters, Converter={StaticResource BoolToVisibleConverter}}"
                            AutomationProperties.AutomationId="NextChapterButton" />

                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <!-- Mute toggle (M13): mpv's real mute flag, glyph follows IsMuted;
                             independent of the volume slider so unmute restores the level. -->
                        <Button x:Name="MuteButton" Style="{StaticResource LwOsdButton}"
                                Click="OnToggleMute" ToolTip="Mute (M)" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="MuteButton">
                            <Button.Content>
                                <TextBlock FontFamily="{StaticResource LwFontIcon}" FontSize="18"
                                           AutomationProperties.ItemStatus="{Binding IsMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{StaticResource IconVolume}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                    <Setter Property="Text" Value="{StaticResource IconMute}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                        <!-- IsMoveToPointEnabled: a click on the track sets the volume to the
                             clicked point. Without it, WPF routes a track click to the
                             Slider.DecreaseLarge / IncreaseLarge RepeatButtons that LwSlider's
                             template puts in the Track, and RangeBase.LargeChange defaults to
                             **1** - so clicking the far left of a 0-100 slider moved the volume
                             from 50 to 49. Measured, not assumed: 50 -> 49 without this
                             attribute, 50 -> 11.1 with it for a click at the 15% mark.
                             SeekSlider has carried the attribute all along; the volume slider
                             shares its style but not this per-instance property, which is why
                             only one of the two ever behaved. (2026-08-05) -->
                        <Slider x:Name="VolumeSlider" Style="{StaticResource LwSlider}"
                                Width="96" Minimum="0" Maximum="100"
                                Value="{Binding Volume, Mode=TwoWay}"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="Volume" />
                        <!-- Output device switcher: hidden unless there is a real choice
                             (>= 2 devices). Lives with the volume cluster (output routing),
                             glyph distinct from the mute speaker. -->
                        <Button x:Name="AudioDeviceButton" Style="{StaticResource LwOsdButton}"
                                Content="{StaticResource IconAudioDevice}" Margin="6,0,0,0"
                                Click="OnAudioDeviceButton" ToolTip="Audio output device"
                                VerticalAlignment="Center"
                                Visibility="{Binding HasAudioDeviceChoices, Converter={StaticResource BoolToVisibleConverter}}"
                                AutomationProperties.AutomationId="AudioDeviceButton" />
                    </StackPanel>

                    <!-- Fullscreen (2026-08-05). Declared FIRST among the right-docked children on
                         purpose: a DockPanel allocates in declaration order, so this both sits
                         rightmost (where video players put it) and is the last thing to be
                         squeezed when the row runs out of width at the 700x480 minimum. F11 and a
                         double-click on the video already did this; the button makes it visible.
                         The glyph flips through OverlayWindow.SetFullscreen, driven by
                         MainWindow.ToggleFullscreen, so it cannot disagree with the real state. -->
                    <Button x:Name="FullscreenButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdButton}"
                            Content="{StaticResource IconFullscreen}" Margin="6,0,0,0"
                            Click="OnFullscreenButton" ToolTip="Fullscreen (F11)"
                            AutomationProperties.Name="Fullscreen"
                            AutomationProperties.AutomationId="FullscreenButton" />
                    <Button x:Name="MiniRestoreButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdButton}"
                            Content="{StaticResource IconMiniRestore}" Margin="6,0,0,0" Visibility="Collapsed"
                            Click="OnMiniRestore" ToolTip="Leave mini-player (Ctrl+M)"
                            AutomationProperties.AutomationId="MiniRestoreButton" />
                    <Button x:Name="MiniPlayerButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdButton}"
                            Content="{StaticResource IconMiniPlayer}" Margin="6,0,0,0"
                            Click="OnMiniPlayer" ToolTip="Mini-player (Ctrl+M)"
                            AutomationProperties.AutomationId="MiniPlayerButton" />
                    <Button x:Name="ShortcutsButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdButton}"
                            Content="{StaticResource IconKeyboard}" Margin="6,0,0,0"
                            Click="OnShortcutsButton" ToolTip="Keyboard shortcuts (?)"
                            AutomationProperties.AutomationId="ShortcutsButton" />
                    <Button x:Name="InfoButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdButton}"
                            Content="{StaticResource IconInfo}" Margin="6,0,0,0"
                            Click="OnInfoButton" ToolTip="Playback and media info"
                            AutomationProperties.AutomationId="InfoButton" />
                    <Button x:Name="SpeedButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Content="{Binding SpeedDisplay}" Margin="6,0,0,0" MinWidth="48"
                            Click="OnSpeedButton" ToolTip="Playback speed (+/- keys)"
                            AutomationProperties.AutomationId="SpeedButton" />
                    <Button x:Name="QueueButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Margin="6,0,0,0" Click="OnQueueButton" ToolTip="Playback queue"
                            Visibility="{Binding HasQueue, Converter={StaticResource BoolToVisibleConverter}}"
                            AutomationProperties.AutomationId="QueueButton">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Queue" />
                            <TextBlock Text="{Binding QueueBadge}" Margin="6,0,0,0" Opacity="0.7"
                                       AutomationProperties.AutomationId="QueueBadge" />
                        </StackPanel>
                    </Button>
                    <!-- Track pickers: the Video/Audio/Subs trio, plus the merged Tracks pill as
                         the NARROW fallback. P10 M11 replaced the trio with the one pill because a
                         DockPanel squeezes right-docked children to zero width once space runs out,
                         silently - at the 700x480 window minimum all three vanished and the speed
                         pill slid under the info button. That fixed the minimum by taxing every
                         width: at 1600 and up there is room for all three and one pill costs the
                         user a click and a read to find out which types even have a choice.
                         Both shapes now ship, and OverlayWindow.UpdateTrackButtons picks between
                         them from a MEASUREMENT rather than a width threshold: it adds up the
                         visible row and shows the trio only when the trio actually fits.
                         The four buttons below are therefore CODE-OWNED (local SetValue, no
                         Visibility binding) - exactly one shape is on screen at a time.
                         Declaration order is reversed on screen (DockPanel.Dock=Right allocates
                         from the right), so Subs/Audio/Video here reads Video Audio Subs there,
                         and the group occupies the merged pill's slot.
                         The fit test EXCLUDES all four of these buttons from the width it sums:
                         a measurement that included them would depend on the decision it is
                         about to make, and the two states would oscillate at the boundary. -->
                    <Button x:Name="SubtitleTracksButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Content="Subs" Margin="6,0,0,0" Visibility="Collapsed"
                            Click="OnSubtitleTracksButton" ToolTip="Subtitle tracks (S)"
                            AutomationProperties.AutomationId="SubtitleTracksButton" />
                    <Button x:Name="AudioTracksButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Content="Audio" Margin="6,0,0,0" Visibility="Collapsed"
                            Click="OnAudioTracksButton" ToolTip="Audio tracks (A)"
                            AutomationProperties.AutomationId="AudioTracksButton" />
                    <Button x:Name="VideoTracksButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Content="Video" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="OnVideoTracksButton" ToolTip="Video tracks (V)"
                            AutomationProperties.AutomationId="VideoTracksButton" />
                    <Button x:Name="TracksButton" DockPanel.Dock="Right" Style="{StaticResource LwOsdPillButton}"
                            Content="Tracks" Margin="12,0,0,0" Visibility="Collapsed"
                            Click="OnTracksButton" ToolTip="Video, audio and subtitle tracks (V/A/S cycle)"
                            AutomationProperties.AutomationId="TracksButton" />
                </DockPanel>
            </Grid>
        </Border>

        <!-- Seek preview: trickplay thumb + timestamp (or timestamp alone) above the hover x.
             Never hit-testable — it floats near the cursor and must not swallow slider input. -->
        <Popup x:Name="SeekPreviewPopup" Placement="Relative" AllowsTransparency="True"
               Focusable="False" IsHitTestVisible="False"
               PlacementTarget="{Binding ElementName=SeekSlider}">
            <Border x:Name="SeekPreviewRoot" Style="{StaticResource LwOsdFlyout}" Padding="5"
                    IsHitTestVisible="False">
                <StackPanel>
                    <Image x:Name="SeekPreviewImage" Stretch="Uniform" Visibility="Collapsed"
                           Margin="0,0,0,4" />
                    <TextBlock x:Name="SeekPreviewTime" HorizontalAlignment="Center"
                               Foreground="{StaticResource LwText1Brush}" FontFamily="{StaticResource LwFontMono}"
                               FontSize="12.5"
                               AutomationProperties.AutomationId="SeekPreviewTime" />
                </StackPanel>
            </Border>
        </Popup>
        <!-- Info panel: live playback state on top, server media metadata in a
             collapsible section below (absent for local files). -->
        <Popup x:Name="InfoPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=InfoButton}"
               Opened="OnInfoPopupOpened" Closed="OnInfoPopupClosed">
            <Border Style="{StaticResource LwOsdFlyout}" Padding="14,10" MinWidth="360" MaxWidth="480">
                <StackPanel>
                    <TextBlock Text="PLAYBACK" Style="{StaticResource LwTypeLabel}" Margin="2,0,0,6" />
                    <ItemsControl ItemsSource="{Binding LiveStats}"
                                  ItemTemplate="{StaticResource InfoRowTemplate}"
                                  AutomationProperties.AutomationId="LiveStatsList" />
                    <Expander Header="Media info" Margin="0,8,0,0" IsExpanded="False"
                              AutomationProperties.AutomationId="MediaInfoExpander"
                              Visibility="{Binding HasMediaInfo, Converter={StaticResource BoolToVisibleConverter}}">
                        <ItemsControl ItemsSource="{Binding MediaInfoRows}" Margin="0,6,0,0"
                                      ItemTemplate="{StaticResource InfoRowTemplate}"
                                      AutomationProperties.AutomationId="MediaInfoList" />
                    </Expander>
                </StackPanel>
            </Border>
        </Popup>
        <Popup x:Name="SpeedPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=SpeedButton}">
            <Border Style="{StaticResource LwOsdFlyout}" MinWidth="120">
                <!-- P10 M8: LwOsdFlyoutItem like the other four OSD lists. Phase 9 M3 created
                     the style precisely to stop stock Fluent container chrome showing here. -->
                <ListBox x:Name="SpeedList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding SpeedOptions}" SelectionChanged="OnSpeedPicked"
                         ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                         AutomationProperties.AutomationId="SpeedList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="2,3">
                                <Border Width="20">
                                    <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource LwFontIcon}" FontSize="16"
                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisibleConverter}}" />
                                </Border>
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        <!-- Queue popup: click a row to jump, X removes (the playing row can't be removed) -->
        <Popup x:Name="QueuePopup" StaysOpen="False" Placement="Top" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=QueueButton}">
            <Border Style="{StaticResource LwOsdFlyout}" MinWidth="280" MaxHeight="420">
                <!-- No virtualization: queues are small (<=500) and UIA readers (and
                     scroll-to-current) need real containers for every row. -->
                <ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding QueueRows}" SelectionChanged="OnQueueRowPicked"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="False"
                         ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                         AutomationProperties.AutomationId="QueueList">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2,3" LastChildFill="True" MinWidth="250">
                                <Border DockPanel.Dock="Left" Width="20">
                                    <TextBlock Text="{StaticResource IconCheck}" FontFamily="{StaticResource LwFontIcon}" FontSize="16"
                                               Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibleConverter}}" />
                                </Border>
                                <Button DockPanel.Dock="Right" Content="{StaticResource IconClose}"
                                        FontFamily="{StaticResource LwFontIcon}" Width="24" Height="22"
                                        FontSize="14" Padding="0" Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnQueueRowRemove" Tag="{Binding}"
                                        ToolTip="Remove from queue"
                                        Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibleConverter}}" />
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Position}" Opacity="0.5"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Display}" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
        <!-- One flyout, three sections (P10 M11). The three ListBoxes keep their original
             AutomationIds: they are the same lists, reached by one button instead of three.
             Which sections are up is code-owned (OverlayWindow.OpenTracks): the per-type pills
             open the same popup showing only their own section, the merged pill shows every
             type that has a choice. The sections carry no Visibility binding for that reason -
             a binding would fight the per-button mode. -->
        <Popup x:Name="TracksPopup" StaysOpen="False" Placement="Top" AllowsTransparency="True">
            <Border Style="{StaticResource LwOsdFlyout}" MinWidth="260" MaxHeight="520">
                <!-- The ONE scroller: the three lists below have their own turned off, so each
                     lays out at full height and this is the only thing that scrolls. Without
                     that a wheel notch over a list moved that list's private viewport and the
                     flyout as a whole looked stuck. -->
                <ScrollViewer x:Name="TracksScroller" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              AutomationProperties.AutomationId="TracksScroller">
                    <StackPanel x:Name="TracksSections" Margin="0,0,4,0"
                                PreviewMouseWheel="OnTracksWheel">
                        <StackPanel x:Name="VideoSection" Visibility="Collapsed">
                            <TextBlock Text="VIDEO" Style="{StaticResource LwOsdFlyoutSectionHeader}"
                                       AutomationProperties.AutomationId="TracksVideoHeader" />
                            <ListBox x:Name="VideoList" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding VideoTracks}" SelectionChanged="OnVideoTrackPicked"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="VideoTrackList"
                                     ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                                     ItemTemplate="{StaticResource TrackOptionTemplate}" />
                        </StackPanel>
                        <StackPanel x:Name="AudioSection" Visibility="Collapsed">
                            <TextBlock Text="AUDIO" Style="{StaticResource LwOsdFlyoutSectionHeader}"
                                       AutomationProperties.AutomationId="TracksAudioHeader" />
                            <ListBox x:Name="AudioList" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding AudioTracks}" SelectionChanged="OnAudioTrackPicked"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="AudioTrackList"
                                     ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                                     ItemTemplate="{StaticResource TrackOptionTemplate}" />
                        </StackPanel>
                        <StackPanel x:Name="SubsSection" Visibility="Collapsed">
                            <TextBlock Text="SUBTITLES" Style="{StaticResource LwOsdFlyoutSectionHeader}"
                                       AutomationProperties.AutomationId="TracksSubsHeader" />
                            <ListBox x:Name="SubsList" Background="Transparent" BorderThickness="0"
                                     ItemsSource="{Binding SubtitleTracks}" SelectionChanged="OnSubtitleTrackPicked"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     AutomationProperties.AutomationId="SubtitleTrackList"
                                     ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                                     ItemTemplate="{StaticResource TrackOptionTemplate}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Popup>
        <!-- Audio output devices: same flyout/row language as the track popups; the
             garnet-selected row is mpv's CURRENT device (AudioDeviceOption.IsSelected). -->
        <Popup x:Name="AudioDevicePopup" StaysOpen="False" Placement="Top" AllowsTransparency="True"
               PlacementTarget="{Binding ElementName=AudioDeviceButton}">
            <Border Style="{StaticResource LwOsdFlyout}" MinWidth="260" MaxHeight="420">
                <ListBox x:Name="AudioDeviceList" Background="Transparent" BorderThickness="0"
                         ItemsSource="{Binding AudioDevices}" SelectionChanged="OnAudioDevicePicked"
                         AutomationProperties.AutomationId="AudioDeviceList"
                         ItemContainerStyle="{StaticResource LwOsdFlyoutItem}"
                         ItemTemplate="{StaticResource AudioDeviceOptionTemplate}" />
            </Border>
        </Popup>

        <!-- Mini-player resize grip (M12): bottom-right corner drag, 16:9-locked in the
             owner's WM_SIZING hook. Mini mode only (SetMiniMode). Its mouse-down is
             handled so the video-area drag-to-move doesn't also fire. -->
        <!-- Near-transparent Background + Padding: a background-less TextBlock only
             hit-tests its GLYPH PIXELS, and this arrow's center is empty - presses fell
             through to the video and became drag-to-move/Windows-snap (seen live). -->
        <TextBlock x:Name="MiniResizeGrip" Text="{StaticResource IconResizeGrip}"
                   FontFamily="{StaticResource LwFontIcon}" FontSize="16"
                   Background="#01000000"
                   Padding="12,12,0,0"
                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,2"
                   Cursor="SizeNWSE" Visibility="Collapsed" ToolTip="Resize"
                   MouseLeftButtonDown="OnMiniResizeGrip"
                   AutomationProperties.AutomationId="MiniResizeGrip">
            <!-- M7.4: match the OSD icon rest/hover language (dim -> lit on hover), like the
                 LwOsdButton siblings; a Button would break the drag-to-resize mouse-down. -->
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{StaticResource LwText2Brush}" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource LwText1Brush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- Keyboard-shortcuts panel (P10 M9), player host. Last child so it sits over the
             controls; the browse layer has its own instance in MainWindow. -->
        <views:ShortcutsOverlay x:Name="Shortcuts" />
    </Grid>
</Window>
