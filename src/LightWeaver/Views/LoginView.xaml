<UserControl x:Class="LightWeaver.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LightWeaver.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!-- S1 Connect / Login: the one screen with full atmosphere — woven-light ornament
         + hero glow behind a garnet brand mark and the sign-in card. -->
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource LwTypeLabel}">
            <Setter Property="Margin" Value="1,0,0,7" />
        </Style>
    </UserControl.Resources>
    <Grid Background="{StaticResource LwStorm0Brush}">
        <!-- M6.2: the card scrolls in row 0 and the build footer owns row 1, so at 700x480
             the footer can't overlap Sign-in and the full form stays reachable. -->
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Woven crosshatch, masked to a soft radial vignette -->
        <Rectangle Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="False">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,17,17" ViewportUnits="Absolute"
                              Viewbox="0,0,17,17" ViewboxUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="17,17" />
                                    <LineGeometry StartPoint="17,0" EndPoint="0,17" />
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Brush="#0D8ECEEB" Thickness="1" />
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
            <Rectangle.OpacityMask>
                <RadialGradientBrush Center="0.5,0.4" GradientOrigin="0.5,0.4" RadiusX="0.55" RadiusY="0.7">
                    <GradientStop Color="Black" Offset="0" />
                    <GradientStop Color="Black" Offset="0.55" />
                    <GradientStop Color="Transparent" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.OpacityMask>
        </Rectangle>

        <!-- Hero glow -->
        <Ellipse Grid.Row="0" Grid.RowSpan="2" Width="660" Height="660" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,-120,0,0" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#248ECEEB" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.62" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Brand mark + sign-in card (scrollable so the whole form is reachable at min height) -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,20">
            <!-- P10 M6: brand mark 12 -> LwR3 (16). Brand marks ride the "large" step. -->
            <Border Width="44" Height="44" CornerRadius="{StaticResource LwR3}" HorizontalAlignment="Center"
                    BorderBrush="#80D14560" BorderThickness="1">
                <Border.Background>
                    <RadialGradientBrush Center="0.32,0.28" GradientOrigin="0.32,0.28" RadiusX="0.85" RadiusY="0.85">
                        <GradientStop Color="#FFD14560" Offset="0" />
                        <GradientStop Color="#FFA62339" Offset="0.7" />
                    </RadialGradientBrush>
                </Border.Background>
                <Border.Effect>
                    <DropShadowEffect Color="#FFD14560" BlurRadius="28" ShadowDepth="0" Opacity="0.5" />
                </Border.Effect>
            </Border>

            <TextBlock Text="LightWeaver" FontFamily="{StaticResource LwFontDisplay}" FontSize="42"
                       Foreground="{StaticResource LwText1Brush}" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="#FF8ECEEB" BlurRadius="40" ShadowDepth="0" Opacity="0.25" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBlock Text="{loc:Text LoginView.SignInToYourJellyfinServer.6ae9b440}" Style="{StaticResource LwTypeBody}"
                       Foreground="{StaticResource LwText3Brush}" HorizontalAlignment="Center" Margin="0,6,0,0" />

            <!-- P10 M6, inherited from M5: 12 -> LwR4 (28). The sign-in card is modal-weight
                 hero surface, the same family as LwModalCard and the Up-Next card. -->
            <Border Width="400" CornerRadius="{StaticResource LwR4}" Padding="28" Margin="0,36,0,0"
                    Background="#E00C0E16" BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                    Effect="{StaticResource LwElevation3}">
                <StackPanel>
                    <TextBlock Text="{loc:Text LoginView.Server.51a339ca}" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="ServerBox" Style="{StaticResource LwTextField}"
                             KeyDown="OnFieldKeyDown"
                             AutomationProperties.AutomationId="ServerUrlBox" />
                    <TextBlock x:Name="HttpWarning" Text="{loc:Text LoginView.HttpIsUnencryptedCredentialsTravelInPlain.25d96c74}"
                               Foreground="{StaticResource LwGemAmberTextBrush}" FontSize="12"
                               Margin="1,5,0,0" TextWrapping="Wrap" Visibility="Collapsed" />

                    <TextBlock Text="{loc:Text LoginView.Username.2cbcb1d9}" Style="{StaticResource FieldLabel}" Margin="1,18,0,7" />
                    <TextBox x:Name="UsernameBox" Style="{StaticResource LwTextField}" KeyDown="OnFieldKeyDown"
                             AutomationProperties.AutomationId="UsernameBox" />

                    <TextBlock Text="{loc:Text LoginView.Password.6c4492e4}" Style="{StaticResource FieldLabel}" Margin="1,16,0,7" />
                    <!-- Masked by default; the eye button swaps in a plain-text twin, the same
                         pattern as the OMDB key in Settings. Labels are set in code-behind. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Fields before the button in markup, so Tab reaches the password first. -->
                        <PasswordBox x:Name="PasswordBox" Style="{StaticResource LwPasswordField}" KeyDown="OnFieldKeyDown"
                                     AutomationProperties.AutomationId="PasswordBox"
                                     AutomationProperties.Name="{loc:Text LoginView.Password.6c4492e4}" />
                        <TextBox x:Name="PasswordReveal" Style="{StaticResource LwTextField}" KeyDown="OnFieldKeyDown"
                                 Visibility="Collapsed" FlowDirection="LeftToRight" IsUndoEnabled="False"
                                 AutomationProperties.AutomationId="PasswordReveal"
                                 AutomationProperties.Name="{loc:Text LoginView.Password.6c4492e4}" />
                        <Button x:Name="PasswordPeek" Grid.Column="1" Style="{StaticResource LwIconButton}"
                                Width="38" Height="38" FontFamily="{StaticResource LwFontIcon}" FontSize="18"
                                Margin="6,0,0,0" Click="OnTogglePasswordPeek"
                                Content="{StaticResource IconVisible}"
                                AutomationProperties.AutomationId="PasswordPeek" />
                    </Grid>

                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource LwEmberHoverTextBrush}" TextWrapping="Wrap"
                               FontSize="13" Margin="1,14,0,0" Visibility="Collapsed"
                               AutomationProperties.AutomationId="LoginError" />

                    <Button x:Name="ConnectButton" Content="{loc:Text LoginView.SignIn.49e18cd4}" Click="OnConnect"
                            Style="{StaticResource LwButtonPrimary}"
                            HorizontalAlignment="Stretch" Margin="0,24,0,0" Height="42"
                            AutomationProperties.AutomationId="ConnectButton" />
                    <Button x:Name="QuickConnectButton" Content="{loc:Text LoginView.UseQuickConnectCodeInstead.3a6c8790}"
                            Click="OnQuickConnect" Style="{StaticResource LwLinkButton}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            AutomationProperties.AutomationId="QuickConnectButton" />
                    <Button x:Name="SwitchUserButton" Content="{loc:Text MainWindow.SwitchUserServer.cad78101}"
                            Click="OnSwitchUser" Style="{StaticResource LwLinkButton}"
                            HorizontalAlignment="Center" Margin="0,16,0,0" Visibility="Collapsed"
                            AutomationProperties.AutomationId="LoginSwitchUserButton" />

                    <!-- Quick Connect handshake: shows the code to enter on another device -->
                    <StackPanel x:Name="QuickConnectPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <Border Height="1" Background="{StaticResource LwStrokeBrush}" Margin="0,0,0,16" />
                        <TextBlock Text="{loc:Text LoginView.EnterThisCodeInYourJellyfinApp.eaafd9da}"
                                   Style="{StaticResource LwTypeCaption}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="QcCodeText" FontFamily="{StaticResource LwFontMono}" FontSize="34"
                                   Foreground="{StaticResource LwLightCoreBrush}"
                                   HorizontalAlignment="Center" Margin="0,10,0,0"
                                   AutomationProperties.AutomationId="QcCode">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="#FF8ECEEB" BlurRadius="18" ShadowDepth="0" Opacity="0.4" />
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock x:Name="QcStatusText" Text="{loc:Text LoginView.WaitingForApproval.1da7fbf1}"
                                   Style="{StaticResource LwTypeCaption}" Foreground="{StaticResource LwText3Brush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"
                                   AutomationProperties.AutomationId="QcStatus" />
                        <Button Content="{loc:Text LoginView.Cancel.c7de30cc}" Click="OnQuickConnectCancel" Style="{StaticResource LwButtonGhost}"
                                HorizontalAlignment="Center" Margin="0,14,0,0" Height="32" Padding="18,0"
                                AutomationProperties.AutomationId="QcCancelButton" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- Build signature — own row (collapses when the window is short, see code-behind) -->
        <TextBlock x:Name="BuildLine" Grid.Row="1" HorizontalAlignment="Center" Margin="0,10,0,20"
                   Style="{StaticResource LwTypeMono}" FontSize="11" Foreground="{StaticResource LwText4Brush}"
                   Text="{loc:Text LoginView.LightweaverMpvD3D11.3d368186}" />
    </Grid>
</UserControl>
