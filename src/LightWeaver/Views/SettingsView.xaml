<UserControl x:Class="LightWeaver.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:LightWeaver.Localization"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             AutomationProperties.AutomationId="SettingsPage">
    <!-- S6 Settings — sectioned rows (title + technical subtitle left, control right),
         grouped in storm-2 cards with hairline dividers; Marcellus section headings.
         Phase 9 M6: an in-app browse destination rather than a floating window. No Width/
         Height/MinWidth here - the shell's own 700x480 minimum governs, and the browse
         layer supplies the background. The section heading is kept: the browse header names
         the frame "Settings" too, but this page is long and scrolls, so an in-page title is
         still the anchor when the header scrolls out of mind. -->
    <UserControl.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LwFontDisplay}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource LwText1Brush}" />
            <Setter Property="Margin" Value="2,26,0,0" />
        </Style>
        <Style x:Key="GroupLabel" TargetType="TextBlock" BasedOn="{StaticResource LwTypeLabel}">
            <Setter Property="Margin" Value="3,22,0,8" />
        </Style>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource LwStorm2Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource LwHairlineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource LwR3}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource LwHairlineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="18,11" />
            <Setter Property="MinHeight" Value="60" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LwFontUi}" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource LwText1Brush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RowSub" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource LwFontUi}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource LwText3Brush}" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowSubMono" TargetType="TextBlock" BasedOn="{StaticResource RowSub}">
            <Setter Property="FontFamily" Value="{StaticResource LwFontMono}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style x:Key="RowToggle" TargetType="CheckBox" BasedOn="{StaticResource LwToggleSwitch}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="RowField" TargetType="TextBox" BasedOn="{StaticResource LwTextField}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Width" Value="90" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <Style x:Key="RowCombo" TargetType="ComboBox" BasedOn="{StaticResource LwDropdown}">
            <Setter Property="DockPanel.Dock" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="16,0,0,0" />
        </Style>
        <!-- Masked secret field (OMDB key) + its peek reveal twin -->
        <Style x:Key="RowSecretField" TargetType="PasswordBox" BasedOn="{StaticResource LwPasswordField}">
            <Setter Property="Height" Value="34" />
        </Style>
        <Style x:Key="RowRevealField" TargetType="TextBox" BasedOn="{StaticResource LwTextField}">
            <Setter Property="Height" Value="34" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,8,40,32">
        <StackPanel>
            <TextBlock Text="{loc:Text SettingsView.Settings.ab089ec2}" Style="{StaticResource SectionTitle}" />
            <TextBlock Text="{loc:Text SettingsView.ChangesSaveImmediatelyLanguageAndAutoSkip.2b940636}"
                       Style="{StaticResource RowSub}" Margin="2,4,0,0" />

            <TextBlock Text="{loc:Text SettingsView.InterfaceLanguage.1aef0b8c}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                    <DockPanel LastChildFill="True">
                        <ComboBox x:Name="UiLanguageBox" Style="{StaticResource RowCombo}" Width="210"
                                  DisplayMemberPath="Name" SelectionChanged="OnUiLanguageChanged"
                                  AutomationProperties.AutomationId="UiLanguageBox"
                                  AutomationProperties.Name="{loc:Text SettingsView.InterfaceLanguage.1aef0b8c}" />
                        <TextBlock Text="{loc:Text SettingsView.InterfaceLanguage.1aef0b8c}"
                                   Style="{StaticResource RowTitle}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </Border>

            <Expander x:Name="LibraryNamesExpander" Margin="2,14,2,0" Visibility="Collapsed"
                      Header="{loc:Text SettingsView.LibraryNames}" AutomationProperties.AutomationId="LibraryNamesExpander">
                <Border Style="{StaticResource SettingCard}" Margin="0,8,0,0" Padding="18,12">
                    <StackPanel>
                        <TextBlock x:Name="LibraryNamesHint" Style="{StaticResource RowSub}" TextWrapping="Wrap" Margin="0,0,0,10" />
                        <StackPanel x:Name="LibraryNameRows" />
                        <Button Content="{loc:Text SettingsView.SaveLibraryNames}" Click="OnSaveLibraryNames"
                                Style="{StaticResource LwButtonSecondary}" HorizontalAlignment="Right" Margin="0,8,0,0"
                                AutomationProperties.AutomationId="SaveLibraryNames" />
                    </StackPanel>
                </Border>
            </Expander>

            <!-- ===== Updates ===== -->
            <TextBlock Text="{loc:Text SettingsView.Updates.81f10b50}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="UpdatePolicyBox" Style="{StaticResource RowCombo}" Width="210"
                                      SelectionChanged="OnChanged" AutomationProperties.AutomationId="UpdatePolicyBox"
                                      AutomationProperties.Name="{loc:Text SettingsView.UpdateHandlingPolicy.e73a1a78}" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.UpdateHandling.5d6b08c4}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.ManualIsTheDefaultEveryOptionStill.ae57a554}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <StackPanel>
                            <TextBlock Text="{loc:Text SettingsView.UpdateStatus.3ed2ab35}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="UpdateVersionText" Style="{StaticResource RowSubMono}" AutomationProperties.AutomationId="UpdateVersionText" />
                            <TextBlock x:Name="UpdateStatusText" Text="{loc:Text SettingsView.NoUpdateCheckHasRunYet.b888684f}" Style="{StaticResource RowSub}" AutomationProperties.AutomationId="UpdateStatusText" />
                            <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Height="5" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateDownloadProgress" AutomationProperties.Name="{loc:Text SettingsView.UpdateDownloadProgress.eb0734cd}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <StackPanel Orientation="Horizontal" Margin="2,6,2,6">
                            <Button x:Name="CheckForUpdatesButton" Content="{loc:Text SettingsView.CheckForUpdates.b964dc04}" Style="{StaticResource LwButtonSecondary}" Height="32" Padding="14,0" Click="OnCheckForUpdates" AutomationProperties.AutomationId="CheckForUpdatesButton" AutomationProperties.Name="{loc:Text SettingsView.CheckForUpdates.b964dc04}" />
                            <Button x:Name="DownloadUpdateButton" Content="{loc:Text SettingsView.Download.9ccefefe}" Style="{StaticResource LwButtonSecondary}" Height="32" Padding="14,0" Margin="8,0,0,0" Click="OnDownloadUpdate" IsEnabled="False" AutomationProperties.AutomationId="DownloadUpdateButton" AutomationProperties.Name="{loc:Text SettingsView.DownloadUpdate.02c1beaa}" />
                            <Button x:Name="OpenReleasePageButton" Content="{loc:Text SettingsView.OpenReleasePage.e7bd56f3}" Style="{StaticResource LwButtonSecondary}" Height="32" Padding="14,0" Margin="8,0,0,0" Click="OnOpenReleasePage" Visibility="Collapsed" AutomationProperties.AutomationId="OpenReleasePageButton" AutomationProperties.Name="{loc:Text SettingsView.OpenUpdateReleasePage.7bf96c83}" />
                            <Button x:Name="InstallUpdateButton" Content="{loc:Text SettingsView.InstallNow.e4cf6a26}" Style="{StaticResource LwButtonPrimary}" Height="32" Padding="14,0" Margin="8,0,0,0" Click="OnInstallUpdate" Visibility="Collapsed" AutomationProperties.AutomationId="InstallUpdateButton" AutomationProperties.Name="{loc:Text SettingsView.InstallUpdateNow.48605ebe}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Playback ===== -->
            <TextBlock Text="{loc:Text SettingsView.Playback.ad41a31d}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="HwdecBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="HwdecBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.HardwareDecoding.f60b25fe}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.D3D11Va.cb90e75f}" Style="{StaticResource RowSubMono}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="RtxVsrBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="RtxVsrBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.RtxVideoSuperResolution.dd557561}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.EnabledByDefaultOnRtxGpus.95db4426}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="RtxHdrBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="RtxHdrBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.RtxVideoHdr.7c967b29}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.ToneMapsSdrToHdrByDefault.4cf5d554}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="MaxLumaBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="MaxLumaBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.RtxHdrPeakBrightness.27a9c730}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.NitsMatchTheNvidiaAppValueFor.25d06913}"
                                           Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="MaxBitrateBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="MaxBitrateBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.MaxStreamingBitrate.01c1507d}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.Mbps0UnlimitedAboveTheCapTranscodes.3dc9b605}"
                                           Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <StackPanel>
                            <TextBlock Text="{loc:Text SettingsView.VideoBuffer.1d50fba1}" Style="{StaticResource RowTitle}" />
                            <TextBlock x:Name="VideoBufferHint" Text="{loc:Text SettingsView.StoresUpcomingVideoToSmoothBriefNetwork.a64e6d82}"
                                       AutomationProperties.AutomationId="VideoBufferHint"
                                       Style="{StaticResource RowSub}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Text SettingsView.LessMemorySuitsConstrainedDevicesMoreRead.1a49d512}"
                                       Style="{StaticResource RowSub}" TextWrapping="Wrap" />
                            <TextBlock Text="{loc:Text SettingsView.MoreReadAheadCannotFixAConsistently.de87ee99}"
                                       Style="{StaticResource RowSub}" TextWrapping="Wrap" />
                            <ComboBox x:Name="VideoBufferPresetBox" Style="{StaticResource RowCombo}" Width="180"
                                      HorizontalAlignment="Left" Margin="0,8,0,0"
                                      SelectionChanged="OnVideoBufferPresetChanged"
                                      AutomationProperties.AutomationId="VideoBufferPresetBox">
                                <ComboBoxItem Tag="128" Content="{loc:Text SettingsView.Recommended.d70aa591}" />
                                <ComboBoxItem Tag="32" Content="{loc:Text SettingsView.LessMemory.eaa82daf}" />
                                <ComboBoxItem Tag="512" Content="{loc:Text SettingsView.MoreReadAhead.ef150aea}" />
                                <ComboBoxItem Tag="custom" Content="{loc:Text SettingsView.Custom.cf0bc965}" />
                            </ComboBox>
                        </StackPanel>
                    </Border>
                    <Expander x:Name="VideoBufferAdvancedExpander" Header="{loc:Text SettingsView.AdvancedVideoBuffer.1be72077}"
                              Margin="28,0,28,12" IsExpanded="False"
                              AutomationProperties.AutomationId="VideoBufferAdvancedExpander">
                        <StackPanel Margin="0,8,0,0">
                            <DockPanel LastChildFill="True">
                                <TextBox x:Name="VideoBufferBox" Style="{StaticResource RowField}" Width="80"
                                         TextChanged="OnChanged" AutomationProperties.AutomationId="VideoBufferBox" />
                                <TextBlock Text="{loc:Text SettingsView.CustomSize321024Mib.f3bf7d38}" Style="{StaticResource RowTitle}"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <TextBlock x:Name="VideoBufferCustomError" Margin="0,6,0,0"
                                       Foreground="{StaticResource LwEmberLitBrush}" Style="{StaticResource RowSub}"
                                       TextWrapping="Wrap" Visibility="Collapsed"
                                       AutomationProperties.AutomationId="VideoBufferCustomError" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- ===== Subtitles ===== -->
            <TextBlock Text="{loc:Text SettingsView.Subtitles.f567c565}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="SubScaleLabel" DockPanel.Dock="Right" Width="44"
                                       Foreground="{StaticResource LwText2Brush}" FontFamily="{StaticResource LwFontMono}"
                                       TextAlignment="Right" VerticalAlignment="Center" />
                            <Slider x:Name="SubScaleSlider" Style="{StaticResource LwSlider}"
                                    DockPanel.Dock="Right" Width="150" Minimum="0.5" Maximum="2.0"
                                    TickFrequency="0.1" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="16,0,10,0" ValueChanged="OnChanged"
                                    AutomationProperties.AutomationId="SubScaleSlider" />
                            <TextBlock Text="{loc:Text SettingsView.Size.a2135b08}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="SubLangBox" Style="{StaticResource RowCombo}" Width="180"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="SubLangBox" />
                            <TextBlock Text="{loc:Text SettingsView.PreferredLanguage.419c9982}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="SubFontBox" Style="{StaticResource RowCombo}" Width="180" IsEditable="True"
                                      SelectionChanged="OnChanged" KeyUp="OnChanged"
                                      AutomationProperties.AutomationId="SubFontBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.Font.aa9f1bdc}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.EmptyPlayerDefault.c97e3622}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubFontSizeBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubFontSizeBox" />
                            <TextBlock Text="{loc:Text SettingsView.FontSizeTextSubsDefault38.b1aa3d5d}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubColorBox" Style="{StaticResource RowField}" Width="110"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubColorBox" />
                            <TextBlock Text="{loc:Text SettingsView.TextColorRrggbbEmptyWhite.f11dd71b}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubBorderColorBox" Style="{StaticResource RowField}" Width="110"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubBorderColorBox" />
                            <TextBlock Text="{loc:Text SettingsView.BorderColorRrggbbEmptyBlack.29a20602}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubBorderSizeBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubBorderSizeBox" />
                            <TextBlock Text="{loc:Text SettingsView.BorderSizeDefault3.e1ae5a2b}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubShadowBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubShadowBox" />
                            <TextBlock Text="{loc:Text SettingsView.ShadowOffset0None.70004051}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SubPositionBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SubPositionBox" />
                            <TextBlock Text="{loc:Text SettingsView.VerticalPosition100BottomSmallerHigher.19fd94b4}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Audio ===== -->
            <TextBlock Text="{loc:Text SettingsView.Audio.56bc57d0}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="AudioLangBox" Style="{StaticResource RowCombo}" Width="180"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="AudioLangBox" />
                            <TextBlock Text="{loc:Text SettingsView.PreferredLanguage.419c9982}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="AudioDeviceBox" Style="{StaticResource RowCombo}" Width="220"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="AudioDeviceBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.OutputDevice.aa9731ec}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="AudioDeviceHint" Text="{loc:Text SettingsView.DevicesAreListedOncePlaybackHasStarted.bfd88419}"
                                           Style="{StaticResource RowSub}" Visibility="Collapsed" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="PassthroughBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="PassthroughBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.Passthrough.be72a073}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.BitstreamAc3Eac3DtsTruehdToThe.34cd4fcb}" Style="{StaticResource RowSub}" />
                                <!-- What the SELECTED output will actually accept, asked of WASAPI
                                     directly (AudioPassthroughProbe). Collapsed when nothing can
                                     honestly be said. Bitstreaming is all-or-nothing per device,
                                     and before this the toggle looked active while doing nothing. -->
                                <TextBlock x:Name="PassthroughCapabilityText" Style="{StaticResource RowSub}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                                           Foreground="{StaticResource LwText3Brush}"
                                           AutomationProperties.AutomationId="PassthroughCapability" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="NormalizationBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="NormalizationBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.VolumeNormalization.20ee6742}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.DynaudnormMutuallyExclusiveWithPassthrough.7d926f57}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== External metadata ===== -->
            <TextBlock Text="{loc:Text SettingsView.ExternalMetadata.7fe53556}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <!-- Masked by default; the eye button toggles a plain-text reveal. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="16,0,0,0">
                                <Grid Width="150">
                                    <PasswordBox x:Name="OmdbKeyBox" Style="{StaticResource RowSecretField}"
                                                 PasswordChanged="OnChanged"
                                                 AutomationProperties.AutomationId="OmdbKeyBox" />
                                    <TextBox x:Name="OmdbKeyReveal" Style="{StaticResource RowRevealField}"
                                             Visibility="Collapsed" TextChanged="OnChanged"
                                             AutomationProperties.AutomationId="OmdbKeyReveal" />
                                </Grid>
                                <Button x:Name="OmdbKeyPeek" Style="{StaticResource LwIconButton}"
                                        Width="34" Height="34" FontFamily="{StaticResource LwFontIcon}"
                                        FontSize="18" Margin="6,0,0,0" Click="OnToggleOmdbPeek"
                                        Content="{StaticResource IconVisible}" ToolTip="{loc:Text SettingsView.ShowHideTheKey.f560351d}"
                                        AutomationProperties.Name="{loc:Text SettingsView.ShowOrHideTheKey.1f056043}"
                                        AutomationProperties.AutomationId="OmdbKeyPeek" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.OmdbApiKey.dfbf0fe4}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.ImdbRottenTomatoesMetacriticScoresOnThe.a3fb9ec9}"
                                           Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Behavior ===== -->
            <TextBlock Text="{loc:Text SettingsView.Behavior.b02d814e}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="AutoSkipIntroBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="AutoSkipIntroBox" />
                            <TextBlock Text="{loc:Text SettingsView.AutomaticallySkipIntrosAndRecaps.fa3203e8}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="AutoSkipCreditsBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="AutoSkipCreditsBox" />
                            <TextBlock Text="{loc:Text SettingsView.AutomaticallySkipCredits.3fb0334d}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="AutoPlayNextBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="AutoPlayNextBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.AutoPlayTheNextEpisode.f84f1bc6}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.OffStillShowsTheUpNextCard.36f22457}"
                                           Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="AutoPlayCountdownBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="AutoPlayCountdownBox" />
                            <TextBlock Text="{loc:Text SettingsView.AutoPlayCountdownSeconds.b2484c53}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SkipForwardBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SkipForwardBox" />
                            <TextBlock Text="{loc:Text SettingsView.JumpForwardSecondsRightArrow.83f8d3fc}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="SkipBackwardBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="SkipBackwardBox" />
                            <TextBlock Text="{loc:Text SettingsView.JumpBackSecondsLeftArrow.781e92ab}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="LargeSkipBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="LargeSkipBox" />
                            <TextBlock Text="{loc:Text SettingsView.LargeJumpSecondsCtrlLeftRightArrows.07952a26}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Downloads (Phase 7 M20) ===== -->
            <TextBlock Text="{loc:Text SettingsView.Downloads.c87e5c91}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <!-- Phase 9 M5: the path is picked, not typed. The box stays as the path
                         DISPLAY (read-only) so a mistyped folder can't be saved; Browse opens the
                         native folder picker and Clear restores the app-data default. -->
                    <Border Style="{StaticResource SettingRow}">
                        <!-- Label docked LEFT, buttons docked RIGHT, and the path box takes
                             whatever is between (LastChildFill). The other rows put a
                             fixed-width field on the right and let the label fill, but that
                             shape does not survive here: box 260 + Browse + Clear needs ~475 px,
                             more than the whole card has at the 480 px window minimum, and the
                             row was pushed clean out of the card - a blank DOWNLOADS box.
                             Filling instead lets the path shrink and keeps every control
                             reachable; the full path stays available as the box's tooltip. -->
                        <DockPanel LastChildFill="True">
                            <!-- Docked right in declaration order (buttons outermost, then the
                                 path box), with the LABEL as the fill child so it - not the
                                 controls - absorbs the squeeze and wraps. The controls keep a
                                 real minimum, so nothing is ever pushed out of the card. -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DownloadBrowseButton" Style="{StaticResource LwButtonSecondary}"
                                        Height="34" Padding="14,0" Content="{loc:Text SettingsView.Browse.a8cde17e}"
                                        Click="OnBrowseDownloadDir" ToolTip="{loc:Text SettingsView.ChooseTheDownloadFolder.37147ee3}"
                                        AutomationProperties.AutomationId="DownloadBrowseButton" />
                                <Button x:Name="DownloadClearButton" Style="{StaticResource LwButtonGhost}"
                                        Height="34" Padding="12,0" Margin="6,0,0,0" Content="{loc:Text SettingsView.Clear.ffbee473}"
                                        Click="OnClearDownloadDir" ToolTip="{loc:Text SettingsView.UseTheAppDataDownloadsFolder.39141335}"
                                        AutomationProperties.AutomationId="DownloadClearButton" />
                            </StackPanel>
                            <TextBox x:Name="DownloadDirBox" Style="{StaticResource RowField}"
                                     DockPanel.Dock="Right"
                                     Width="Auto" MinWidth="120" MaxWidth="260" Margin="12,0,8,0"
                                     IsReadOnly="True" TextChanged="OnChanged"
                                     ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                                     AutomationProperties.AutomationId="DownloadDirBox" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{loc:Text SettingsView.DownloadFolder.963446ec}" Style="{StaticResource RowTitle}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{loc:Text SettingsView.EmptyLightweaverSAppDataDownloadsFolder.f1cdbe70}"
                                           Style="{StaticResource RowSub}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="MaxParallelBox" Style="{StaticResource RowCombo}" Width="80"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="MaxParallelBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.SimultaneousDownloads.a87d5eb2}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.AdditionalItemsWaitAsQueued.08b8c60a}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="DefaultResolutionBox" Style="{StaticResource RowCombo}" Width="120"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="DefaultResolutionBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.PreferredDownloadQuality.60aebff1}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.PreselectedInThePickerSourcesBelowThe.6ed0420e}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Storage (Phase 7 M21): cache readouts + clears + image cap ===== -->
            <TextBlock Text="{loc:Text SettingsView.Storage.e0e3e2f4}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="ImageCacheSizeLabel" DockPanel.Dock="Right" Width="72"
                                       Foreground="{StaticResource LwText2Brush}" FontFamily="{StaticResource LwFontMono}"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="ImageCacheSizeLabel" />
                            <Slider x:Name="ImageCacheSizeSlider" Style="{StaticResource LwSlider}"
                                    DockPanel.Dock="Right" Width="150" Minimum="100" Maximum="2000"
                                    TickFrequency="100" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="16,0,10,0" ValueChanged="OnChanged"
                                    AutomationProperties.AutomationId="ImageCacheSizeSlider" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.ImageCacheLimit.2a714794}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.LruEvictionTrimsThePosterThumbnailCache.0b148c6f}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBlock x:Name="FolderCacheSizeLabel" DockPanel.Dock="Right" Width="72"
                                       Foreground="{StaticResource LwText2Brush}" FontFamily="{StaticResource LwFontMono}"
                                       TextAlignment="Right" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="FolderCacheSizeLabel" />
                            <Slider x:Name="FolderCacheSizeSlider" Style="{StaticResource LwSlider}"
                                    DockPanel.Dock="Right" Width="150" Minimum="500" Maximum="20000"
                                    TickFrequency="500" IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center" Margin="16,0,10,0" ValueChanged="OnChanged"
                                    AutomationProperties.AutomationId="FolderCacheSizeSlider" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.FolderCacheLimit.43376c44}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.MaximumItemsCachedPerLibraryFolder.5e86a3a4}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ImageCacheClearButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.Clear.ffbee473}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Click="OnClearImageCache" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ImageCacheClearButton" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.ImagesPostersThumbnailsTrickplay.1628db4f}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="ImageCacheReadout" Text="{loc:Text SettingsView.0B.b17da85c}" Style="{StaticResource RowSubMono}"
                                           AutomationProperties.AutomationId="ImageCacheReadout" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="MetadataCacheClearButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.Clear.ffbee473}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Click="OnClearMetadataCache" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="MetadataCacheClearButton" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.MediaInfo.e0c50633}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="MetadataCacheReadout" Text="{loc:Text SettingsView.0B.b17da85c}" Style="{StaticResource RowSubMono}"
                                           AutomationProperties.AutomationId="MetadataCacheReadout" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="ExternalCacheClearButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.Clear.ffbee473}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Click="OnClearExternalCache" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="ExternalCacheClearButton" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.ExternalMetadataOmdb.40273ee5}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="ExternalCacheReadout" Text="{loc:Text SettingsView.0B.b17da85c}" Style="{StaticResource RowSubMono}"
                                           AutomationProperties.AutomationId="ExternalCacheReadout" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Button x:Name="ClearAllCacheButton" Content="{loc:Text SettingsView.ClearAllCaches.91d9ede6}"
                                Style="{StaticResource LwButtonDestructive}" Height="32" Padding="14,0"
                                HorizontalAlignment="Left" Margin="2,6,0,6" Click="OnClearAllCaches"
                                AutomationProperties.AutomationId="ClearAllCacheButton" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Shortcuts (Phase 7 M16) — rows generated in code from PlayerAction ===== -->
            <TextBlock Text="{loc:Text SettingsView.Shortcuts.6b2fd38c}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <!-- Transport mapping (M17): what Media Next/Previous (and the
                         overlay next/prev pair) do. -->
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="TransportNextBox" Style="{StaticResource RowCombo}" Width="180"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="TransportNextBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.MediaNextDoes.9d8a65fd}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.MediaKeyThePlayerSNextButton.18c82417}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <ComboBox x:Name="TransportPrevBox" Style="{StaticResource RowCombo}" Width="180"
                                      SelectionChanged="OnChanged"
                                      AutomationProperties.AutomationId="TransportPrevBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.MediaPreviousDoes.d884b4d8}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.MediaKeyThePlayerSPreviousButton.d18927d8}" Style="{StaticResource RowSub}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border x:Name="TransportSeekRow" Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <TextBox x:Name="TransportSeekBox" Style="{StaticResource RowField}" Width="80"
                                     TextChanged="OnChanged"
                                     AutomationProperties.AutomationId="TransportSeekBox" />
                            <TextBlock Text="{loc:Text SettingsView.TransportSeekAmountSeconds.a8749b3e}" Style="{StaticResource RowTitle}" />
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{loc:Text SettingsView.KeyboardShortcutsClickABindingThenPress.b61da8ba}"
                               Style="{StaticResource RowSub}" Margin="2,8,2,4" TextWrapping="Wrap" />
                    <StackPanel x:Name="ShortcutsHost" />
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <Button x:Name="ShortcutsResetButton" Content="{loc:Text SettingsView.ResetToDefaults.2f8aa8cd}"
                                Style="{StaticResource LwButtonSecondary}" HorizontalAlignment="Left"
                                Margin="2,6,0,6" Click="OnShortcutsReset"
                                AutomationProperties.AutomationId="ShortcutsResetButton" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Diagnostics: the log folder and how much goes into it =====
                 Crash and playback-failure files are written whatever this says - they are the
                 evidence that cannot be collected after the fact. The toggle only decides
                 whether the running commentary is kept too. -->
            <TextBlock Text="{loc:Text SettingsView.Diagnostics.afaa146b}" Style="{StaticResource GroupLabel}" />
            <Border Style="{StaticResource SettingCard}">
                <StackPanel>
                    <Border Style="{StaticResource SettingRow}">
                        <DockPanel LastChildFill="True">
                            <CheckBox x:Name="VerboseLoggingBox" Style="{StaticResource RowToggle}"
                                      Checked="OnChanged" Unchecked="OnChanged"
                                      AutomationProperties.AutomationId="VerboseLoggingBox" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.VerboseLogging.9b2f78c1}" Style="{StaticResource RowTitle}" />
                                <TextBlock Text="{loc:Text SettingsView.KeepsFullMpvOutputAndPlaybackSession.e49557fc}"
                                           Style="{StaticResource RowSub}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource SettingRow}" BorderThickness="0">
                        <DockPanel LastChildFill="True">
                            <Button x:Name="LogsClearButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.Clear.ffbee473}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Click="OnClearLogs" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="LogsClearButton" />
                            <Button x:Name="LogsOpenButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.OpenFolder.fd396b9a}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Margin="0,0,8,0" Click="OnOpenLogsFolder" VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="LogsOpenButton" />
                            <!-- "Open folder" tells you where the logs are; this is for handing
                                 them to someone else. One zip, so there is nothing to explain
                                 about which of four files matters. -->
                            <Button x:Name="LogsExportButton" DockPanel.Dock="Right" Content="{loc:Text SettingsView.Export.419f870c}"
                                    Style="{StaticResource LwButtonSecondary}" Height="30" Padding="12,0"
                                    Margin="0,0,8,0" Click="OnExportLogs" VerticalAlignment="Center"
                                    ToolTip="{loc:Text SettingsView.SaveAllLogFilesAsOneZip.fb9cc13f}"
                                    AutomationProperties.AutomationId="LogsExportButton" />
                            <StackPanel>
                                <TextBlock Text="{loc:Text SettingsView.LogFiles.68bcb2b9}" Style="{StaticResource RowTitle}" />
                                <TextBlock x:Name="LogsReadout" Text="{loc:Text SettingsView.0B.b17da85c}" Style="{StaticResource RowSubMono}"
                                           AutomationProperties.AutomationId="LogsReadout" />
                                <TextBlock x:Name="LogsPath" Style="{StaticResource RowSub}" TextWrapping="Wrap"
                                           AutomationProperties.AutomationId="LogsPath" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
