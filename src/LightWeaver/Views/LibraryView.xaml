<UserControl x:Class="LightWeaver.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:LightWeaver.Views"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!-- Header (M3.1): a 2-row / 2-col grid. QueueActions or CountText hold the left
             cluster (row 0, col 0); the sort/filter cluster (row 0, col 1, right-aligned)
             drops to a full-width second row and wraps when it can't fit — so SortBox never
             clips and OrderButton never disappears at 700 px. Repositioned in OnViewSizeChanged. -->
        <Grid x:Name="HeaderBar" Grid.Row="0" Margin="40,20,20,0"
              Background="Transparent" PreviewMouseWheel="OnDeadZoneWheel">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Queue entry points: visible for seasons/series/playlists only -->
            <StackPanel x:Name="QueueActions" Grid.Row="0" Grid.Column="0" Orientation="Horizontal"
                        Visibility="Collapsed" VerticalAlignment="Center">
                <Button x:Name="PlayAllButton" Style="{StaticResource LwButtonPrimary}"
                        Height="34" Padding="16,0"
                        Click="OnPlayAll" AutomationProperties.AutomationId="PlayAllButton">
                    <TextBlock VerticalAlignment="Center"><Run Text="{StaticResource IconPlay}"
                            FontFamily="{StaticResource LwFontIcon}" BaselineAlignment="Center" /><Run Text="  Play all" /></TextBlock>
                </Button>
                <Button x:Name="ShuffleButton" Style="{StaticResource LwButtonSecondary}"
                        Content="🔀  Shuffle" Height="34" Padding="16,0"
                        Margin="10,0,0,0" Click="OnShuffle"
                        AutomationProperties.AutomationId="ShuffleButton" />
                <Button x:Name="DownloadAllButton" Style="{StaticResource LwButtonSecondary}"
                        Height="34" Padding="16,0" Margin="10,0,0,0" Click="OnDownloadAll"
                        AutomationProperties.AutomationId="DownloadAllButton">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{StaticResource IconDownload}"
                                   FontFamily="{StaticResource LwFontIcon}" FontSize="16"
                                   VerticalAlignment="Center" Margin="0,0,7,0" />
                        <TextBlock Text="Download" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <!-- Item count (paged grids) -->
            <!-- The id exists so a suite can read the total. It is the only surface that
                 distinguishes an exact-prefix letter filter from the server's letter-JUMP: the
                 first page of "M" and the first page of "M and after" hold the same cards, so
                 comparing visible names cannot tell them apart, but 12 items and 143 items can. -->
            <TextBlock x:Name="CountText" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                       Style="{StaticResource LwTypeMono}" Foreground="{StaticResource LwText3Brush}"
                       Visibility="Collapsed"
                       AutomationProperties.AutomationId="LibraryCount" />
            <!-- Sort/filter controls: paged library grids only. WrapPanel so the controls
                 flow onto more lines rather than clip when the header row is tight. -->
            <WrapPanel x:Name="SortPanel" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed">
                <Button x:Name="GenresButton" Style="{StaticResource LwButtonSecondary}"
                        Content="Genres" Height="34" Padding="14,0"
                        Margin="0,0,10,0" Visibility="Collapsed" Click="OnGenresClick"
                        AutomationProperties.AutomationId="GenresButton" />
                <ComboBox x:Name="GenreBox" Style="{StaticResource LwDropdown}" Width="150"
                          SelectionChanged="OnQueryChanged"
                          AutomationProperties.AutomationId="GenreBox" />
                <!-- Watched filter as a segmented control (M22): all three options visible,
                     one click to switch; same handler + AutomationId as the dropdown
                     it replaces. -->
                <views:LwSegmentedControl x:Name="FilterBox" Style="{StaticResource LwSegmented}"
                          Margin="10,0,0,0" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="FilterBox" />
                <ComboBox x:Name="SortBox" Style="{StaticResource LwDropdown}" Width="160" Margin="10,0,0,0"
                          SelectionChanged="OnQueryChanged"
                          AutomationProperties.AutomationId="SortBox" />
                <ToggleButton x:Name="OrderButton" Style="{StaticResource LwIconToggle}"
                              Width="34" Height="34" Margin="10,0,0,0"
                              FontFamily="{StaticResource LwFontIcon}" FontSize="18"
                              Content="{StaticResource IconSortAsc}" Checked="OnQueryChanged" Unchecked="OnQueryChanged"
                              ToolTip="Sort order"
                              AutomationProperties.AutomationId="OrderButton" />
                <!-- P10 M11: the A-Z rail's stand-in. M3.4 hides the rail below 700 view-width
                     "so it can't crowd the grid", which at the window minimum left a 274-item
                     library with no way to reach a letter at all. This appears exactly when the
                     rail hides, drives the same filter, and lives in the header WrapPanel, which
                     already flows onto more rows rather than clipping. -->
                <ComboBox x:Name="LetterJumpBox" Style="{StaticResource LwDropdown}" Width="130"
                          Margin="10,0,0,0" Visibility="Collapsed"
                          ToolTip="Show only one letter"
                          SelectionChanged="OnLetterJumpChanged"
                          AutomationProperties.AutomationId="LetterJumpBox" />
            </WrapPanel>
        </Grid>
        <!-- Row 1 (M3.4): cards in col 0, the A-Z rail in its own reserved col 1 (Auto width,
             so it collapses to 0 when hidden) — the rail can no longer overlap cards. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- 8 px of the inset lives on the items panel's Margin rather than on Padding, and the
                 two cancel so column count and position are unchanged. Padding insets the
                 ScrollViewer - i.e. the CLIP - so it sat flush with the first card, and the hover
                 scale on LwMediaCardItem (1.03 about the card's centre) was cut off: a hovered
                 leftmost poster rendered "8 Mile" as "3 Mile" and squared off the poster's rounded
                 left corner. Same fix as HomeView's PageScroll and MediaRowListBox. -->
            <ListBox x:Name="ItemsGrid" Grid.Column="0"
                     Background="Transparent" BorderThickness="0"
                     ItemTemplateSelector="{StaticResource MediaCardSelector}"
                     ItemContainerStyle="{StaticResource LwMediaGridItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     SelectionChanged="OnSelection"
                     Padding="32,18,12,2"
                     AutomationProperties.AutomationId="LibraryGrid">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="8" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <!-- A-Z letter filter (Name sort only): letter rail in its reserved column. A click
                 shows ONLY that letter; the x:Name keeps its "Jump" spelling because the
                 AutomationId of the same name is asserted by phase5/phase10 suites. -->
            <StackPanel x:Name="LetterStrip" Grid.Column="1"
                        VerticalAlignment="Center" Margin="0,0,6,0" Visibility="Collapsed"
                        PreviewMouseWheel="OnDeadZoneWheel"
                        AutomationProperties.AutomationId="LetterStrip" />
            <!-- Cache / refresh status pill floating at the bottom of the grid (similar to LoadMoreIndicator) -->
            <Border x:Name="StatusPill" Grid.Column="0"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Background="{StaticResource LwStorm3Brush}"
                    CornerRadius="{StaticResource LwR2}"
                    Effect="{StaticResource LwElevation2}"
                    Padding="14,8" Margin="0,0,0,18"
                    IsHitTestVisible="False"
                    Visibility="{Binding Visibility, ElementName=StatusText}">
                <StackPanel Orientation="Horizontal">
                    <views:ActivityDots x:Name="StatusDots" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Loading…"
                               FontFamily="{StaticResource LwFontUi}" FontSize="13"
                               Foreground="{StaticResource LwText2Brush}"
                               VerticalAlignment="Center" Margin="10,0,0,0"
                               Visibility="Collapsed"
                               AutomationProperties.AutomationId="LibraryStatus" />
                </StackPanel>
            </Border>
            <views:EmptyState x:Name="EmptyView" Grid.Column="0" />
            <!-- M25: grid skeleton while the first page loads -->
            <ScrollViewer x:Name="SkeletonHost" Grid.Column="0" Visibility="Collapsed"
                          VerticalScrollBarVisibility="Disabled" Padding="40,6,0,0" />
            <!-- "Loading more" pill for the infinite-scroll append (2026-08-02). Column 0 so
                 it can never sit under the A-Z rail, bottom-centred over the last card row. -->
            <views:LoadMoreIndicator x:Name="MoreLoading" Grid.Column="0" />
        </Grid>
    </Grid>
</UserControl>
