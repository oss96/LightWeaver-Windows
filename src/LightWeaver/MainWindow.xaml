<Window x:Class="LightWeaver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:player="clr-namespace:LightWeaver.Player"
        xmlns:theme="clr-namespace:LightWeaver.Theme"
        xmlns:views="clr-namespace:LightWeaver.Views"
        mc:Ignorable="d"
        Title="LightWeaver" Height="720" Width="1280"
        MinWidth="700" MinHeight="480"
        Background="{StaticResource LwStorm1Brush}"
        Foreground="{StaticResource LwText1Brush}"
        FontFamily="{StaticResource LwFontUi}">
    <Window.Resources>
        <!-- 16x16 vector icons for the taskbar thumbnail buttons -->
        <DrawingImage x:Key="IconThumbPlay">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 3,1 L 14,8 L 3,15 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconThumbPause">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 3,1 H 7 V 15 H 3 Z M 9,1 H 13 V 15 H 9 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconThumbBack">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 8,1 L 1,8 L 8,15 Z M 15,1 L 8,8 L 15,15 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>
        <DrawingImage x:Key="IconThumbForward">
            <DrawingImage.Drawing>
                <GeometryDrawing Brush="White" Geometry="M 1,1 L 8,8 L 1,15 Z M 8,1 L 15,8 L 8,15 Z" />
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Nav-rail glyphs are now Material Icons (Rounded) referenced by the shared
             LwNavRailItem/LwNavRailButton templates via Tag = Icon* string (Theme/Icons.xaml). -->
    </Window.Resources>
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo>
            <TaskbarItemInfo.ThumbButtonInfos>
                <ThumbButtonInfo x:Name="ThumbJumpBack" Description="Jump back"
                                 IsEnabled="False" Click="OnThumbJumpBack"
                                 ImageSource="{StaticResource IconThumbBack}" />
                <ThumbButtonInfo x:Name="ThumbPlayPause" Description="Play / pause"
                                 IsEnabled="False" Click="OnThumbPlayPause"
                                 ImageSource="{StaticResource IconThumbPlay}" />
                <ThumbButtonInfo x:Name="ThumbJumpForward" Description="Jump forward"
                                 IsEnabled="False" Click="OnThumbJumpForward"
                                 ImageSource="{StaticResource IconThumbForward}" />
            </TaskbarItemInfo.ThumbButtonInfos>
        </TaskbarItemInfo>
    </Window.TaskbarItemInfo>
    <Grid>
        <!-- Browse layer: left nav rail + content (login / home / library / detail views) -->
        <Grid x:Name="BrowseLayer">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left navigation rail (primary navigation) =====
                 Expanded 232 / collapsed 64 (icons only) via theme:NavRail.IsCollapsed,
                 an inherited flag the code-behind flips below 1160 px window width. -->
            <Border x:Name="NavRail" Grid.Column="0" Width="232"
                    Background="{StaticResource LwStorm1Brush}"
                    BorderBrush="{StaticResource LwHairlineBrush}" BorderThickness="0,0,1,0"
                    Padding="12,22" Visibility="Collapsed">
                <DockPanel>
                    <!-- Bottom group: Settings + profile affordance -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Style="{StaticResource LwMenuSeparator}" Margin="10,10" />
                        <RadioButton x:Name="NavStream" GroupName="NavRail"
                                     Style="{StaticResource LwNavRailItem}"
                                     Tag="{StaticResource IconPlay}" Content="Stream from URL"
                                     Click="OnOpenStream" ToolTip="Stream from URL" ToolTipOpening="OnStreamToolTipOpening"
                                     AutomationProperties.AutomationId="NavStream" />
                        <Button x:Name="NavSettings" Style="{StaticResource LwNavRailButton}"
                                Tag="{StaticResource IconSettings}" Content="Settings"
                                Click="OnNavSettings" ToolTip="Settings"
                                AutomationProperties.AutomationId="NavSettings" />
                        <Button x:Name="ProfileButton" Height="44" Cursor="Hand"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                Click="OnProfileClick" FocusVisualStyle="{x:Null}"
                                ToolTip="Account" AutomationProperties.AutomationId="ProfileButton">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- P10 M6, inherited from M5: this row still carried LwR2 (12)
                                         while every rail row above it is a stadium. Invisible at
                                         rest (transparent chrome) but wrong the moment it is
                                         hovered. Same binding as LwNavRailItem: h44 -> r22. -->
                                    <Border x:Name="Chrome" Background="Transparent"
                                            CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                                            SnapsToDevicePixels="True">
                                        <StackPanel x:Name="ItemContent" Orientation="Horizontal" Margin="8,0"
                                                    VerticalAlignment="Center" HorizontalAlignment="Left">
                                            <!-- 26x26 at r13 = a true circle; unchanged (decision d). -->
                                            <Border Width="26" Height="26" CornerRadius="13">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                        <GradientStop Color="{StaticResource LwSapphireColor}" Offset="0" />
                                                        <GradientStop Color="{StaticResource LwStorm4Color}" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <TextBlock x:Name="ProfileInitial" Text="?" FontSize="12"
                                                           FontWeight="SemiBold" Foreground="{StaticResource LwText1Brush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock x:Name="ProfileName" Text="Account" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" FontSize="14"
                                                       Foreground="{StaticResource LwText2Brush}" />
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource LwGhostHoverFillBrush}" />
                                            <Setter TargetName="ProfileName" Property="Foreground" Value="{StaticResource LwText1Brush}" />
                                        </Trigger>
                                        <Trigger Property="theme:NavRail.IsCollapsed" Value="True">
                                            <Setter TargetName="ItemContent" Property="HorizontalAlignment" Value="Center" />
                                            <Setter TargetName="ItemContent" Property="Margin" Value="0" />
                                            <Setter TargetName="ProfileName" Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ProfileMenu" Style="{StaticResource LwContextMenu}">
                                    <MenuItem Header="Open local file…" Click="OnOpenFile" InputGestureText="Ctrl+O" />
                                    <MenuItem Header="Switch user / server…" Click="OnSwitchServer" InputGestureText="Ctrl+U" />
                                    <MenuItem x:Name="UpdateMenuItem" Visibility="Collapsed" Click="OnInstallUpdate"
                                              AutomationProperties.AutomationId="UpdateMenuItem" />
                                    <Separator Style="{StaticResource LwMenuSeparator}" />
                                    <MenuItem x:Name="LogoutItem" Header="Log out" Click="OnLogout" Visibility="Collapsed" />
                                    <MenuItem Header="Exit" Click="OnExit" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <!-- Top group: Home + the server's libraries (LastChild fills, top-aligned).
                         SCROLLABLE, and that is a correctness fix rather than polish: this was a
                         bare StackPanel, so once Home + one row per library + Downloads grew taller
                         than the rail, the DockPanel's remaining space simply clipped the last child.
                         At the app's 700x480 minimum with six libraries, "the last child" is
                         Downloads - a top-level destination clipped away ENTIRELY, which is exactly
                         what the minimum-size rule forbids. (The faint dash left in its place, which
                         a first report mistook for a sliver of the icon at rgb(29,33,45), is the
                         BOTTOM group's Separator; the icon itself rendered nothing at all.) The scrollbar
                         is Auto rather than Hidden on purpose: at that size something has to give,
                         and a visible affordance saying "there is more below" is the honest version
                         of giving. Horizontal scrolling is disabled so the icons never shift. -->
                    <!-- The id exists so a suite can read this scroller's offset. Added with the
                         ScrollViewer on 2026-08-03 in spirit only - it was omitted, which left the
                         rail's scrolling unassertable, and the 2026-07-15 wheel audit predates the
                         scroller entirely. -->
                    <ScrollViewer x:Name="NavTopScroll" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Padding="0" Focusable="False"
                                  AutomationProperties.AutomationId="NavRailScroll">
                    <StackPanel x:Name="NavTopGroup" VerticalAlignment="Top">
                        <RadioButton x:Name="NavHome" GroupName="NavRail" IsChecked="True"
                                     Style="{StaticResource LwNavRailItem}"
                                     Tag="{StaticResource IconHome}" Content="Home"
                                     Click="OnNavHome" ToolTip="Home"
                                     AutomationProperties.AutomationId="NavHome" />
                        <StackPanel x:Name="LibrariesNav" />
                        <RadioButton x:Name="NavDownloads" GroupName="NavRail"
                                     Style="{StaticResource LwNavRailItem}"
                                     Tag="{StaticResource IconDownload}" Content="Downloads"
                                     Click="OnNavDownloads" ToolTip="Downloads"
                                     AutomationProperties.AutomationId="NavDownloads" />
                    </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Content column ===== -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" x:Name="BrowseHeader" Padding="40,20,28,8"
                        Visibility="Collapsed">
                    <DockPanel>
                        <Button x:Name="BrowseBackBtn" DockPanel.Dock="Left"
                                Style="{StaticResource LwButtonGhost}"
                                Content="{StaticResource IconBack}" FontFamily="{StaticResource LwFontIcon}"
                                Width="38" Height="34" FontSize="20" Padding="0"
                                VerticalAlignment="Center" Margin="0,0,6,0"
                                Click="OnBrowseBack"
                                AutomationProperties.AutomationId="BrowseBackButton" />
                        <Button x:Name="BrowseForwardBtn" DockPanel.Dock="Left"
                                Style="{StaticResource LwButtonGhost}"
                                Content="{StaticResource IconForward}" FontFamily="{StaticResource LwFontIcon}"
                                Width="38" Height="34" FontSize="20" Padding="0"
                                VerticalAlignment="Center" Margin="0,0,14,0"
                                Click="OnBrowseForward"
                                AutomationProperties.AutomationId="BrowseForwardButton" />
                        <!-- Search pill (right).
                             P10 M6, disposition (b): the literal 19 was already the CORRECT
                             hand-computed stadium (= 38/2) and LwRPill's 999 would have clamped
                             per edge and regressed this 360 px pill into a lens — exactly what
                             M5 measured on LwSearchField. Routed through LwRFullFromHeight
                             instead: identical 19 px today, self-documenting, and it survives a
                             height change. -->
                        <Border x:Name="SearchPill" DockPanel.Dock="Right" Height="38" Width="360"
                                CornerRadius="{Binding ActualHeight, RelativeSource={RelativeSource Self}, Converter={StaticResource LwRFullFromHeight}}"
                                Background="{StaticResource LwStorm2Brush}"
                                BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                                VerticalAlignment="Center">
                            <DockPanel LastChildFill="True" Margin="16,0">
                                <TextBlock DockPanel.Dock="Left" Text="{StaticResource IconSearch}"
                                           FontFamily="{StaticResource LwFontIcon}" FontSize="17"
                                           Foreground="{StaticResource LwText3Brush}" VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <!-- Search activity ring (2026-08-02), docked at the trailing edge of
                                     the pill. It covers BOTH cases a results-grid skeleton cannot: the
                                     first search, where no results view exists yet to skeleton, and a
                                     refinement, where blanking visible results would be worse than
                                     leaving them up. ActivityDots suppresses its automation peer, so
                                     the id rides a transparent non-empty TextBlock beside it. -->
                                <Grid x:Name="SearchSpinnerHost" DockPanel.Dock="Right"
                                      Visibility="Collapsed" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <views:ActivityDots />
                                    <TextBlock Text="Searching" Foreground="Transparent" FontSize="1"
                                               AutomationProperties.AutomationId="SearchSpinner" />
                                </Grid>
                                <Grid VerticalAlignment="Center">
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search your libraries"
                                               Foreground="{StaticResource LwText3Brush}" FontSize="14"
                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                             Foreground="{StaticResource LwText1Brush}" CaretBrush="{StaticResource LwLightCoreBrush}"
                                             FontSize="14" VerticalContentAlignment="Center" Padding="0"
                                             TextChanged="OnSearchTextChanged"
                                             AutomationProperties.AutomationId="SearchBox"
                                             ToolTip="Search movies, series and episodes (min. 2 characters)">
                                        <!-- Minimal template: the pill is the only chrome, so the default
                                             TextBox mouse-over background never shows (only the I-beam cursor). -->
                                        <TextBox.Template>
                                            <ControlTemplate TargetType="TextBox">
                                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                              Background="Transparent" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </TextBox.Template>
                                    </TextBox>
                                </Grid>
                            </DockPanel>
                        </Border>
                        <!-- Advanced search affordance (left of the search pill) -->
                        <Button x:Name="AdvancedSearchBtn" DockPanel.Dock="Right"
                                Style="{StaticResource LwButtonSecondary}" Height="38"
                                Padding="14,0" Margin="0,0,10,0" VerticalAlignment="Center"
                                Click="OnAdvancedSearch" ToolTip="Advanced search"
                                AutomationProperties.AutomationId="AdvancedSearchButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{StaticResource IconTune}" FontFamily="{StaticResource LwFontIcon}"
                                           FontSize="18" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Advanced" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="BrowseTitle" Style="{StaticResource LwTypeTitle}" FontSize="20"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="BrowseTitle" />
                    </DockPanel>
                </Border>
                <ContentControl x:Name="ShellHost" />
            </DockPanel>
        </Grid>

        <!-- Video layer: mpv child HWND; shown only while playing -->
        <Border x:Name="VideoArea" Background="{StaticResource LwStorm0Brush}" Visibility="Collapsed">
            <player:MpvPlayerHost x:Name="PlayerHost" />
        </Border>

        <!-- Subtle update banner (browse layer only, like the toast) -->
        <Border x:Name="UpdateBanner"
                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,24" CornerRadius="{StaticResource LwR2}" Padding="16,11"
                Background="{StaticResource LwStorm3Brush}"
                BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                Effect="{StaticResource LwElevation2}"
                Visibility="Collapsed" Cursor="Hand"
                MouseLeftButtonDown="OnUpdateBannerClick">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,12,0"
                         Fill="{StaticResource LwSapphireLitBrush}" Effect="{StaticResource LwGlowToggleOn}" />
                <TextBlock x:Name="UpdateBannerText" FontSize="14" VerticalAlignment="Center"
                           Foreground="{StaticResource LwText1Brush}"
                           AutomationProperties.AutomationId="UpdateBanner" />
                <TextBlock Text="{StaticResource IconClose}" FontFamily="{StaticResource LwFontIcon}"
                           FontSize="15" Margin="14,0,0,0" Opacity="0.6" VerticalAlignment="Center"
                           Foreground="{StaticResource LwText2Brush}"
                           MouseLeftButtonDown="OnUpdateBannerDismiss"
                           AutomationProperties.AutomationId="UpdateBannerDismiss" />
            </StackPanel>
        </Border>

        <!-- Transient error/info toast (browse layer only — the mpv HWND would
             cover it while playing; playback errors return to Browse first) -->
        <Border x:Name="Toast"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,16,0,0" MaxWidth="640"
                CornerRadius="{StaticResource LwR2}" Padding="16,12"
                Background="{StaticResource LwStorm3Brush}"
                BorderBrush="{StaticResource LwStrokeBrush}" BorderThickness="1"
                Effect="{StaticResource LwElevation2}"
                Visibility="Collapsed"
                MouseLeftButtonDown="OnToastClick">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="8" Height="8" VerticalAlignment="Top" Margin="0,5,12,0"
                         Fill="{StaticResource LwEmberLitBrush}" Effect="{StaticResource LwGlowEmber}" />
                <!-- AutomationId lives on the TextBlock: Border has no automation peer -->
                <TextBlock x:Name="ToastText" TextWrapping="Wrap" MaxWidth="560"
                           AutomationProperties.AutomationId="Toast"
                           Foreground="{StaticResource LwText1Brush}" FontSize="14" />
            </StackPanel>
        </Border>

        <!-- Modal layer (M23): topmost, collapsed until a confirm/alert shows -->
        <views:ModalHost x:Name="Modal" />

        <!-- Keyboard-shortcuts panel (P10 M9), browse-layer host. The player has its own
             instance in OverlayWindow — WPF cannot draw over the mpv HWND. -->
        <views:ShortcutsOverlay x:Name="Shortcuts" />
    </Grid>
</Window>
