<!--
  Woven-light design tokens: elevation & glow.
  All blooms are DropShadowEffect (blur <= 28, ShadowDepth 0 for glows) — no full-screen blur anywhere.
  Glow accents stay <= 0.55 alpha so they cannot bloom over HDR highlights.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Elevation ladder (dark ambient shadows) -->
    <DropShadowEffect x:Key="LwElevation1" Color="#FF000000" Opacity="0.45" BlurRadius="8" ShadowDepth="2" Direction="270" />  <!-- cards -->
    <DropShadowEffect x:Key="LwElevation2" Color="#FF000000" Opacity="0.55" BlurRadius="24" ShadowDepth="8" Direction="270" /> <!-- menus -->
    <DropShadowEffect x:Key="LwElevation3" Color="#FF000000" Opacity="0.65" BlurRadius="28" ShadowDepth="12" Direction="270" /> <!-- modals (spec 16/48, clamped to blur budget) -->

    <!-- Stormlight glows (diffuse, ShadowDepth 0) -->
    <DropShadowEffect x:Key="LwGlowFocus" Color="#FF8ECEEB" Opacity="0.35" BlurRadius="12" ShadowDepth="0" />  <!-- focus ring bloom -->
    <DropShadowEffect x:Key="LwGlowHover" Color="#FF8ECEEB" Opacity="0.22" BlurRadius="18" ShadowDepth="0" />  <!-- hover bloom -->
    <DropShadowEffect x:Key="LwGlowGarnet" Color="#FFD14560" Opacity="0.34" BlurRadius="20" ShadowDepth="0" /> <!-- primary hover / resume progress -->
    <DropShadowEffect x:Key="LwGlowEmber" Color="#FFC93A2E" Opacity="0.25" BlurRadius="16" ShadowDepth="0" />  <!-- destructive hover -->
    <DropShadowEffect x:Key="LwGlowKnob" Color="#FFDDF1FA" Opacity="0.60" BlurRadius="8" ShadowDepth="0" />    <!-- infused toggle knob (legacy) -->
    <DropShadowEffect x:Key="LwGlowKnobGarnet" Color="#FFD14560" Opacity="0.55" BlurRadius="8" ShadowDepth="0" /> <!-- garnet slider handle / toggle knob (Phase 8 M1) -->
    <DropShadowEffect x:Key="LwGlowToggleOn" Color="#FFD14560" Opacity="0.28" BlurRadius="12" ShadowDepth="0" /> <!-- toggle on-track bloom — garnet (Phase 8 M1) -->

    <!-- Media gem-pill text glow (spec text-shadow 0 0 8px). Applied to pill glyph text. -->
    <DropShadowEffect x:Key="LwGlowPillBlue" Color="#FF8ECEEB" Opacity="0.50" BlurRadius="8" ShadowDepth="0" />
    <DropShadowEffect x:Key="LwGlowPillAmber" Color="#FFE9B25C" Opacity="0.45" BlurRadius="8" ShadowDepth="0" />
    <DropShadowEffect x:Key="LwGlowPillGarnet" Color="#FFD14560" Opacity="0.50" BlurRadius="8" ShadowDepth="0" /> <!-- checked interactive OSD pill (Phase 8 M1) -->

</ResourceDictionary>
