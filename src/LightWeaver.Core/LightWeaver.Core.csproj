<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>LightWeaver</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LightWeaver.Localization\LightWeaver.Localization.csproj" />
    <EmbeddedResource Include="..\..\localization\catalog.json" LogicalName="LightWeaver.Localization.catalog.json" />
    <EmbeddedResource Include="..\..\localization\locales\*.json" LogicalName="LightWeaver.Localization.locales.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LightWeaver" />
    <InternalsVisibleTo Include="Login.Tests" />
    <InternalsVisibleTo Include="PlayerSettings.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Sdk" Version="2026.10.12" />
    <PackageReference Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Form" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Multipart" Version="2.1.2" />
    <PackageReference Include="Microsoft.Kiota.Serialization.Text" Version="2.1.2" />
    <PackageReference Include="Std.UriTemplate" Version="2.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
  </ItemGroup>

</Project>
